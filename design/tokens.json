{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": 1,
  "defaults": {
    "theme": "aurora",
    "font": {
      "apple": "system-ui",
      "windows": "Segoe UI Variable, Microsoft YaHei UI"
    },
    "radius": { "control": 10, "card": 16, "panel": 22, "sheet": 28 },
    "spacing": [4, 8, 12, 16, 24, 32],
    "motion": { "pressMs": 150, "pageMs": 220, "sheetMs": 320 },
    "minimumTouchTarget": 44
  },
  "themes": {
    "aurora": {
      "name": "青碧玻璃",
      "source": "image-3549.png",
      "mode": "system",
      "colors": {
        "background": "#071F1C",
        "surface": "#123C36CC",
        "surfaceElevated": "#1B5048E6",
        "primary": "#55E1B2",
        "secondary": "#E6B85C",
        "text": "#F1FFF9",
        "textMuted": "#A9C8BE",
        "border": "#83EAC733",
        "danger": "#FF6B6B"
      },
      "material": { "blur": 28, "opacity": 0.78, "glow": 0.18, "particles": true }
    },
    "paper": {
      "name": "清透纸感",
      "source": "image-3550.png",
      "mode": "light",
      "colors": {
        "background": "#F5F7F5",
        "surface": "#FFFFFFF2",
        "surfaceElevated": "#FFFFFF",
        "primary": "#1F7A50",
        "secondary": "#6FA88B",
        "text": "#1B2B24",
        "textMuted": "#6D7E75",
        "border": "#163E2A1F",
        "danger": "#C94040"
      },
      "material": { "blur": 12, "opacity": 0.96, "glow": 0.0, "particles": false }
    },
    "midnight": {
      "name": "午夜霓虹",
      "source": "image-3551.png",
      "mode": "dark",
      "colors": {
        "background": "#070B14",
        "surface": "#101827E8",
        "surfaceElevated": "#162235F2",
        "primary": "#00D5FF",
        "secondary": "#FF3DAE",
        "text": "#F4F8FF",
        "textMuted": "#8FA2BB",
        "border": "#39D8FF38",
        "danger": "#FF5577"
      },
      "material": { "blur": 20, "opacity": 0.92, "glow": 0.28, "particles": true }
    }
  },
  "layout": {
    "mobileTabs": ["主页", "搜索", "音乐库", "我的"],
    "desktopNavigation": ["主页", "搜索", "音乐库", "下载", "本地音乐", "播放列表"],
    "desktopRightRailCollapse": 900,
    "desktopSidebarCollapse": 680
  }
}
