<Application
    x:Class="Beans.Windows.Rebuild.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Spacing.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Buttons.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Inputs.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Sliders.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Lists.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Cards.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Shell.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
