<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Player.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:player="using:Beans.Windows.Rebuild.Pages.Player"
    xmlns:playback="using:Beans.Windows.Rebuild.Services.Playback"
    xmlns:controls="using:Beans.Windows.Rebuild.Controls">
    <Grid x:Name="RootGrid" IsTabStop="True" KeyDown="RootGrid_KeyDown" SizeChanged="Player_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="AnimeStageRoot" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF8F4FF" Offset="0" />
                    <GradientStop Color="#FFEDE8FF" Offset="0.48" />
                    <GradientStop Color="#FFDDF7F4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-300" Fill="#40C6A9FF" />
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-210,-230" Fill="#42FFB5D7" />
            <Ellipse Width="210" Height="210" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,190,0" Fill="#74FFD7A1" />
            <Canvas VerticalAlignment="Bottom" Height="230" Opacity="0.22">
                <Rectangle Canvas.Left="0" Canvas.Top="105" Width="120" Height="125" Fill="#6C5C78A4" />
                <Rectangle Canvas.Left="135" Canvas.Top="64" Width="90" Height="166" Fill="#6C5C78A4" />
                <Rectangle Canvas.Left="240" Canvas.Top="122" Width="150" Height="108" Fill="#6C5C78A4" />
                <Rectangle Canvas.Left="405" Canvas.Top="40" Width="110" Height="190" Fill="#6C5C78A4" />
                <Rectangle Canvas.Left="530" Canvas.Top="90" Width="190" Height="140" Fill="#6C5C78A4" />
                <Rectangle Canvas.Left="735" Canvas.Top="20" Width="130" Height="210" Fill="#6C5C78A4" />
            </Canvas>
            <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,226" Background="#66FFFFFF" />
            <Border Height="260" VerticalAlignment="Bottom" Background="#20FFFFFF" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,72,0" Opacity="0.42" Spacing="3">
                <TextBlock Text="BEANS / ANIME" FontSize="12" FontWeight="SemiBold" Foreground="#665A4A78" CharacterSpacing="180" />
                <TextBlock Text="MUSIC SESSION 01" FontSize="10" Foreground="#665A4A78" CharacterSpacing="90" />
            </StackPanel>
        </Grid>
        <Image x:Name="BackdropImage" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="1" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="BackdropScale" ScaleX="1.04" ScaleY="1.04" /><TranslateTransform x:Name="BackdropPan" /></TransformGroup></Image.RenderTransform>
        </Image>
        <Grid x:Name="AnimeSceneHost" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" />
        <Grid x:Name="AnimeColorGrade" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.1">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#421D4B96" Offset="0" />
                        <GradientStop Color="#101E51A0" Offset="0.52" />
                        <GradientStop Color="#382C216F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#121D4C93" Offset="0" />
                        <GradientStop Color="#40203A68" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Image x:Name="PersonMotionImage" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.28,0.52" Visibility="Collapsed">
            <Image.RenderTransform><CompositeTransform x:Name="PersonMotionTransform" ScaleX="1.006" ScaleY="1.006" /></Image.RenderTransform>
        </Image>
        <Image x:Name="BackdropOverlayImage" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="0.28" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OverlayScale" ScaleX="1.02" ScaleY="1.02" />
                    <TranslateTransform x:Name="OverlayTransform" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Canvas x:Name="BackgroundParticles" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed" />
        <Grid x:Name="BackdropTint" Grid.RowSpan="3">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#B807151C" Offset="0" />
                    <GradientStop Color="#5A07141A" Offset="0.42" />
                    <GradientStop Color="#18040B10" Offset="0.78" />
                    <GradientStop Color="#52050910" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <Border x:Name="LocalBlurVeil" Grid.RowSpan="3" Background="#18000000" IsHitTestVisible="False" Opacity="0.22" />
        <Canvas x:Name="PersonWindCanvas" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.9" />
        <Canvas x:Name="AmbientRingsCanvas" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.9" />
        <Canvas x:Name="AudioVisualizerCanvas" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.72" />
        <Border x:Name="WaveOne" Grid.Row="1" Height="110" Width="900" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="80" Opacity="0.035">
            <Border.RenderTransform><TranslateTransform x:Name="WaveOneTransform" /></Border.RenderTransform>
        </Border>
        <Border x:Name="WaveTwo" Grid.Row="1" Height="70" Width="700" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="60" Opacity="0.025">
            <Border.RenderTransform><TranslateTransform x:Name="WaveTwoTransform" /></Border.RenderTransform>
        </Border>
        <Grid x:Name="AnimeHud" Grid.RowSpan="3" Visibility="Collapsed">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Canvas x:Name="AnimeHudCanvas" Width="1660" Height="948">
                    <Button x:Name="AnimeBackButton" Canvas.Left="12" Canvas.Top="48" Style="{StaticResource AnimeReferenceGhostButtonStyle}" Click="Back_Click" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回"><FontIcon Glyph="&#xE72B;" FontSize="19" /></Button>
                    <StackPanel x:Name="AnimeBrandArea" Canvas.Left="52" Canvas.Top="48" Width="270" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Viewbox Width="34" Height="36" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="飞鸟">
                                <Canvas Width="40" Height="42">
                                    <Path Fill="#CFFFFFFF" Data="M 21,22 C 18,17 22,10 27,5 L 33,0 C 33,10 28,19 25,23 L 34,37 L 23,28 L 7,39 L 16,26 C 10,25 5,22 1,18 C 9,18 16,17 21,22 Z" />
                                    <Path Stroke="White" StrokeThickness="1" Data="M 1,34 Q 12,25 25,19 L 32,7 M 8,29 L 17,30 M 17,26 L 29,34 M 21,22 Q 21,14 28,9 M 22,20 L 9,20 M 27,12 L 32,12 M 27,16 L 31,15 M 26,20 L 30,18" />
                                    <Path Fill="White" Data="M 22,22 Q 27,18 29,20 L 33,20 L 29,22 Q 26,27 22,26 Z" />
                                </Canvas>
                            </Viewbox>
                            <controls:AnimeInkText Text="放課後の空と、&#x0a;都市のメロディ" FontSize="22" CharacterSpacing="90" Width="220">
                                <controls:AnimeInkText.RenderTransform><SkewTransform AngleX="-5" /></controls:AnimeInkText.RenderTransform>
                            </controls:AnimeInkText>
                        </StackPanel>
                        <Border Height="1" Width="220" HorizontalAlignment="Left" Background="#C0FFFFFF" />
                        <controls:AnimeInkText Text="音楽が、また明日を連れてくる" FontSize="12" CharacterSpacing="110" />
                    </StackPanel>
                    <Border Canvas.Left="550" Canvas.Top="86" Width="166" Height="157" CornerRadius="8" Background="#24FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <Image Source="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Canvas.Left="755" Canvas.Top="86" Width="395" Spacing="5">
                        <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" FontSize="25" CharacterSpacing="28" FontFamily="Noto Serif SC, Yu Mincho" Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" FontSize="14" CharacterSpacing="15" FontFamily="Noto Serif SC, Yu Mincho" Foreground="#D9FFFFFF" />
                        <Slider x:Name="AnimeProgressSlider" Width="395" Height="28" Margin="0,18,0,0" Style="{StaticResource AnimeReferenceSliderStyle}" Minimum="0" Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" KeyUp="AnimeProgressSlider_KeyUp" AutomationProperties.Name="播放进度" />
                        <Grid Width="395" Margin="0,-2,0,0"><TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}" FontSize="12" FontFamily="Noto Serif SC, Yu Mincho" Foreground="#E6FFFFFF" /><TextBlock Text="{x:Bind Player.DurationText, Mode=OneWay}" FontSize="12" FontFamily="Noto Serif SC, Yu Mincho" Foreground="#E6FFFFFF" HorizontalAlignment="Right" /></Grid>
                        <StackPanel Orientation="Horizontal" Spacing="28" Margin="0,18,0,0" HorizontalAlignment="Left">
                            <Button x:Name="AnimeShuffleButton" Style="{StaticResource AnimeReferenceShuffleButtonStyle}" Click="Shuffle_Click" AutomationProperties.Name="切换随机播放"><FontIcon Glyph="&#xE8B1;" FontSize="21" /></Button>
                            <Button x:Name="AnimePreviousButton" Style="{StaticResource AnimeReferenceControlButtonStyle}" Click="Previous_Click" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="23" /></Button>
                            <Button x:Name="AnimePlayButton" Style="{StaticResource AnimeReferencePlayButtonStyle}" Click="PlayPause_Click" AutomationProperties.Name="播放或暂停"><FontIcon Glyph="{x:Bind Player.PlayPauseGlyph, Mode=OneWay}" FontSize="28" /></Button>
                            <Button x:Name="AnimeNextButton" Style="{StaticResource AnimeReferenceControlButtonStyle}" Click="Next_Click" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="23" /></Button>
                            <Button x:Name="AnimeFavoriteButton" Style="{StaticResource AnimeReferenceControlButtonStyle}" Click="Favorite_Click" AutomationProperties.Name="收藏"><FontIcon Glyph="&#xEB51;" FontSize="23" /></Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Canvas.Left="1518" Canvas.Top="42" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="AnimeFullscreenButton" Style="{StaticResource AnimeReferenceGhostButtonStyle}" Click="Fullscreen_Click" ToolTipService.ToolTip="全屏" AutomationProperties.Name="进入全屏"><FontIcon x:Name="AnimeFullscreenGlyph" Glyph="&#xE740;" FontSize="17" /></Button>
                        <Button x:Name="AnimeQueueButton" Style="{StaticResource AnimeReferenceGhostButtonStyle}" Click="Queue_Click" ToolTipService.ToolTip="播放队列" AutomationProperties.Name="打开播放队列"><FontIcon Glyph="&#xEA37;" FontSize="18" /></Button>
                    </StackPanel>
                    <ListView x:Name="AnimeLyricList" Canvas.Left="1280" Canvas.Top="104" Width="320" Height="350" ItemsSource="{x:Bind Lines}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Lyric_ItemClick" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="二次元歌词">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,0" /><Setter Property="MinHeight" Value="32" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="player:PlayerLyricRow"><controls:AnimeInkText Text="{x:Bind Text}" FontSize="{x:Bind FontSize, Mode=OneWay}" IsActive="{x:Bind IsActive, Mode=OneWay}" ReduceMotion="{x:Bind ReduceMotion, Mode=OneWay}" MotionEnabled="{x:Bind MotionEnabled, Mode=OneWay}" SweepSeconds="{x:Bind SweepSeconds}" LyricMode="True" CharacterSpacing="10" Centered="True" Opacity="{x:Bind Opacity, Mode=OneWay}" Margin="0,3" /></DataTemplate>
                    </ListView.ItemTemplate>
                    </ListView>
                    <Grid x:Name="AnimeQueueCard" Canvas.Left="1236" Canvas.Top="528" Width="364" Height="328" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform Angle="6.2" /></Grid.RenderTransform>

                        <!-- Refracted shadow and bottom caustic sit outside the clear slab. -->
                        <Border Margin="15,17,-18,-20" CornerRadius="27" Background="#30508FC2" Opacity="0.72" IsHitTestVisible="False" />
                        <Border Margin="72,252,-22,-26" CornerRadius="70" Opacity="0.8" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#008EE8FF" Offset="0" /><GradientStop Color="#809DE9FF" Offset="0.34" />
                                    <GradientStop Color="#6FD7B7FF" Offset="0.64" /><GradientStop Color="#5FFFF0AC" Offset="0.82" /><GradientStop Color="#00FFF0AC" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Thick outer glass: bright top/left, cyan-violet depth on bottom/right. -->
                        <Border Margin="-11,-11,-15,-17" CornerRadius="28" BorderBrush="#DFFFFFFF" BorderThickness="3" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F0FFFFFF" Offset="0" /><GradientStop Color="#98DDF5FF" Offset="0.16" />
                                    <GradientStop Color="#72D9C5FF" Offset="0.46" /><GradientStop Color="#A279D9FF" Offset="0.72" />
                                    <GradientStop Color="#9DFFE7A9" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Margin="-5,-5,-9,-11" CornerRadius="23" BorderBrush="#A7FFFFFF" BorderThickness="2" Background="#4097D9F8" IsHitTestVisible="False" />

                        <!-- Main translucent pane. -->
                        <Border CornerRadius="19" BorderBrush="#F2FFFFFF" BorderThickness="2" IsHitTestVisible="False">
                            <Border.Background>
                                <AcrylicBrush TintColor="#D3EEFF" TintOpacity="0.30" TintLuminosityOpacity="0.52" Opacity="0.94" FallbackColor="#D9DDF3FF" />
                            </Border.Background>
                        </Border>
                        <Border Margin="4" CornerRadius="16" BorderBrush="#62FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#76FFFFFF" Offset="0" /><GradientStop Color="#14FFFFFF" Offset="0.28" />
                                    <GradientStop Color="#48DDBBFF" Offset="0.55" /><GradientStop Color="#3E82E7FF" Offset="0.76" />
                                    <GradientStop Color="#42FFEAB3" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Uneven specular bands keep the rim dimensional instead of painted. -->
                        <Border Height="5" Margin="38,-4,118,0" VerticalAlignment="Top" CornerRadius="4" Background="#EFFFFFFF" IsHitTestVisible="False" />
                        <Border Width="5" Margin="0,54,-5,82" HorizontalAlignment="Right" CornerRadius="4" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0" /><GradientStop Color="#AFCBBDFF" Offset="0.34" />
                                    <GradientStop Color="#D079DFFF" Offset="0.65" /><GradientStop Color="#AFFFF0B6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="6" Margin="88,0,20,-7" VerticalAlignment="Bottom" CornerRadius="4" Background="#A66ED5FF" IsHitTestVisible="False" />

                        <TextBlock x:Name="AnimeQueueEmpty" Text="播放队列为空" FontSize="15" Foreground="#F02C4B71" FontFamily="ms-appx:///Assets/Fonts/KleeOne/KleeOne-Regular.ttf#Klee One" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ItemsControl Margin="10,12" ItemsSource="{x:Bind AnimeQueue}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="player:AnimeQueueEntry">
                                    <Grid Height="76">
                                        <Grid Opacity="{x:Bind GlowOpacity}" IsHitTestVisible="False" Loaded="AnimeQueueGlow_Loaded" />
                                        <Button Click="AnimeQueueItem_Click" Tag="{x:Bind Item}" AutomationProperties.Name="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}" Background="{x:Bind CardBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="5" Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource AnimePaperButtonStyle}">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                                <Border Width="56" Height="56" CornerRadius="4" BorderBrush="#CFFFFFFF" BorderThickness="1">
                                                    <Image Source="{x:Bind ArtworkUri}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Foreground="{x:Bind TitleBrush}" FontSize="16" FontFamily="ms-appx:///Assets/Fonts/KleeOne/KleeOne-Regular.ttf#Klee One" CharacterSpacing="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" FontSize="12" FontWeight="SemiBold" Foreground="#ED274C71" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <FontIcon Grid.Column="3" Glyph="{x:Bind PlayGlyph}" FontSize="16" Foreground="#F067C9FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Border Height="1" Margin="8,0" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" /><GradientStop Color="#BFFFFFFF" Offset="0.42" />
                                                    <GradientStop Color="#5079C9EC" Offset="0.82" /><GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Small glass keychain from the approved mockup. -->
                        <Canvas Width="104" Height="92" Margin="0,-62,-23,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Ellipse Canvas.Left="32" Canvas.Top="0" Width="25" Height="25" Stroke="#B07E6949" StrokeThickness="3" Fill="#20FFFFFF" />
                            <Ellipse Canvas.Left="51" Canvas.Top="18" Width="13" Height="13" Stroke="#B07E6949" StrokeThickness="3" Fill="Transparent" />
                            <Line X1="60" Y1="29" X2="73" Y2="48" Stroke="#B07E6949" StrokeThickness="3" />
                            <TextBlock Canvas.Left="10" Canvas.Top="29" Text="★" FontSize="32" Foreground="#F18DDFFF" />
                            <Ellipse Canvas.Left="54" Canvas.Top="40" Width="49" Height="49" Fill="#CCECF8FF" Stroke="#F7FFFFFF" StrokeThickness="3" />
                            <Ellipse Canvas.Left="58" Canvas.Top="44" Width="41" Height="41" Stroke="#9271CFFF" StrokeThickness="2" />
                            <Border Canvas.Left="61" Canvas.Top="47" Width="35" Height="35" CornerRadius="18">
                                <Image Source="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                        </Canvas>
                        <TextBlock Margin="30,-20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="✦" FontSize="27" Foreground="#F0FFFFFF" IsHitTestVisible="False" />
                        <TextBlock Margin="0,0,-17,28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="✦" FontSize="22" Foreground="#E780D8FF" IsHitTestVisible="False" />
                    </Grid>
                    <StackPanel x:Name="AnimeBottomCopy" Canvas.Left="52" Canvas.Top="756" Spacing="8" RenderTransformOrigin="0,0.5">
                        <StackPanel.RenderTransform><CompositeTransform Rotation="-5" SkewX="-8" /></StackPanel.RenderTransform>
                        <controls:AnimeInkText Text="あの空の下で、&#x0a; また音楽を。" FontSize="27" CharacterSpacing="150" Width="238" />
                        <Path Width="202" Height="22" Stroke="#D9FFFFFF" StrokeThickness="1" Data="M 0,21 Q 100,-2 202,5" Stretch="Fill" HorizontalAlignment="Left" />
                    </StackPanel>
                </Canvas>
            </Viewbox>
        </Grid>        <Grid x:Name="HeaderBar" Grid.Row="0" Margin="24,18" Padding="10,6" ColumnSpacing="16" CornerRadius="14" BorderThickness="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource PlayerIconButtonStyle}" Click="Back_Click" AutomationProperties.Name="返回"><FontIcon Glyph="&#xE72B;" FontSize="19" /></Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="HeaderTitle" Text="{x:Bind Player.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="HeaderSource" Text="{x:Bind Player.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" /><Border x:Name="AnimeBadge" Visibility="Collapsed" HorizontalAlignment="Left" Background="#78FF9DE7" BorderBrush="#C8FFD7F4" BorderThickness="1" CornerRadius="8" Padding="7,2"><TextBlock Text="ANIME STAGE · 二次元舞台" FontSize="10" FontWeight="SemiBold" Foreground="#FFF8F2FF" /></Border></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock x:Name="StyleLabel" Text="歌词风格" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" /><ComboBox x:Name="StyleSelector" Width="140" ItemsSource="{x:Bind VisualStyles}" DisplayMemberPath="Name" SelectionChanged="StyleSelector_SelectionChanged" AutomationProperties.Name="歌词播放器风格" /><TextBlock x:Name="SizeLabel" Text="字号" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" /><Slider x:Name="LyricSizeSlider" Width="82" Minimum="0.8" Maximum="1.4" Value="1" StepFrequency="0.05" ValueChanged="LyricSizeSlider_ValueChanged" AutomationProperties.Name="歌词字号" /><Button x:Name="FullscreenButton" Style="{StaticResource GhostButtonStyle}" Click="Fullscreen_Click" AutomationProperties.Name="进入全屏"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon x:Name="FullscreenGlyph" Glyph="&#xE740;" /><TextBlock x:Name="FullscreenLabel" Text="全屏" /></StackPanel></Button><Button x:Name="QueueButton" Style="{StaticResource GhostButtonStyle}" Click="Queue_Click" AutomationProperties.Name="打开播放队列"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xEA37;" /><TextBlock Text="队列" /></StackPanel></Button></StackPanel>
        </Grid>

        <Grid x:Name="StandardPlayerContent" Grid.Row="1" Margin="28,0,28,18" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SubjectColumn" Width="0.38*" /><ColumnDefinition Width="0.44*" /><ColumnDefinition x:Name="LyricInfoColumn" Width="0.18*" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="SubjectPanel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,12">
                <Button x:Name="ArtworkBubbleButton" Width="52" Height="52" Padding="0" CornerRadius="26"
                        Background="#30000000" BorderBrush="#66FFFFFF" BorderThickness="1"
                        ToolTipService.ToolTip="展开当前歌曲信息" AutomationProperties.Name="当前歌曲信息">
                    <Border x:Name="ArtworkFrame" Width="46" Height="46" CornerRadius="23" Background="#22000000">
                        <Image Source="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <Button.Flyout>
                        <Flyout Placement="Right">
                            <Border Width="250" Padding="16" CornerRadius="14" Background="#E8142028"
                                    BorderBrush="#44FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind Player.Album, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                    <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left" Padding="9,4">
                                        <TextBlock Text="{x:Bind Player.SourceLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Border x:Name="LyricGlassCard" Grid.Column="1" Margin="0,18" Padding="14,8" CornerRadius="22" BorderThickness="1" VerticalAlignment="Stretch">
              <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel x:Name="LyricStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed"><FontIcon Glyph="&#xE8D2;" FontSize="30" HorizontalAlignment="Center" /><TextBlock Text="当前歌曲没有可显示的歌词" Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
                <Border x:Name="LyricSweep" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2" Opacity="0.2" IsHitTestVisible="False" Canvas.ZIndex="0">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#001DFFC8" Offset="0" /><GradientStop Color="#8A8FFFE0" Offset="0.5" /><GradientStop Color="#001DFFC8" Offset="1" /></LinearGradientBrush></Border.Background>
                    <Border.RenderTransform><TranslateTransform x:Name="LyricSweepTransform" /></Border.RenderTransform>
                </Border>
                    <ListView x:Name="LyricList" ItemsSource="{x:Bind Lines}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Lyric_ItemClick" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.Name="沉浸式歌词">
                    <ListView.ItemTemplate><DataTemplate x:DataType="player:PlayerLyricRow"><StackPanel HorizontalAlignment="Center" Spacing="8" Margin="8,20" RenderTransformOrigin="0.5,0.5"><StackPanel.RenderTransform><ScaleTransform ScaleX="{x:Bind Scale, Mode=OneWay}" ScaleY="{x:Bind Scale, Mode=OneWay}" /></StackPanel.RenderTransform><TextBlock FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" Text="{x:Bind Text, Mode=OneWay}" FontSize="{x:Bind FontSize, Mode=OneWay}" FontWeight="{x:Bind Weight, Mode=OneWay}" Foreground="{x:Bind Foreground, Mode=OneWay}" Opacity="{x:Bind Opacity, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" /><TextBlock FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" Text="{x:Bind Translation, Mode=OneWay}" FontSize="{x:Bind TranslationFontSize, Mode=OneWay}" Foreground="{x:Bind Foreground, Mode=OneWay}" Opacity="{x:Bind TranslationOpacity, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
              </Grid>
            </Border>

            <Border Grid.Column="2" x:Name="SidePanel" Background="#99102C3D" BorderBrush="#447EABB7" BorderThickness="1" CornerRadius="14" Padding="18" VerticalAlignment="Top" Margin="0,70,0,0"><StackPanel Spacing="6"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="SideHeader" Text="歌词进度" FontWeight="SemiBold" /><TextBlock x:Name="LyricProgressText" Grid.Column="1" Style="{StaticResource CaptionTextStyle}" /></Grid><ProgressBar x:Name="LyricProgress" Height="3" Minimum="0" Maximum="1" /><TextBlock x:Name="SideCurrentLabel" Text="当前歌词" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="SideCurrentLyric" Text="等待歌词" TextWrapping="Wrap" FontSize="14" MaxLines="2" /><TextBlock x:Name="SideNextLabel" Text="下一句" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" /><TextBlock x:Name="SideNextLyric" Text="" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" MaxLines="2" /></StackPanel></Border>
        </Grid>

        <Grid x:Name="ControlBar" Grid.Row="2" Margin="0" Padding="28,14" MinHeight="120" Background="#C0061E2C" BorderBrush="#38527486" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /><Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource MusicSliderStyle}" Minimum="0" Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" KeyUp="ProgressSlider_KeyUp" AutomationProperties.Name="播放进度" /><TextBlock Grid.Column="2" Text="{x:Bind Player.DurationText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Foreground="#F0FFFFFF" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Foreground="#B8FFFFFF" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <StackPanel Width="54" Spacing="1">
                    <Button x:Name="ShuffleButton" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Center" Click="Shuffle_Click" AutomationProperties.Name="切换随机播放" ToolTipService.ToolTip="切换顺序/随机播放"><FontIcon Glyph="&#xE8B1;" FontSize="17" /></Button>
                        <TextBlock Text="{x:Bind Player.ShuffleModeText, Mode=OneWay}" Foreground="#E8FFFFFF" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="PreviousButton" Style="{StaticResource PlayerIconButtonStyle}" Foreground="White" Click="Previous_Click" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="19" /></Button>
                    <Button x:Name="PlayButton" Style="{StaticResource MainPlayButtonStyle}" Click="PlayPause_Click" AutomationProperties.Name="播放或暂停"><FontIcon Glyph="{x:Bind Player.PlayPauseGlyph, Mode=OneWay}" FontSize="22" /></Button>
                    <Button x:Name="NextButton" Style="{StaticResource PlayerIconButtonStyle}" Foreground="White" Click="Next_Click" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="19" /></Button>
                    <StackPanel Width="64" Spacing="1">
                        <Button x:Name="RepeatButton" Style="{StaticResource PlayerIconButtonStyle}" Foreground="White" HorizontalAlignment="Center" Click="Repeat_Click" AutomationProperties.Name="切换循环模式" ToolTipService.ToolTip="切换循环模式"><FontIcon Glyph="&#xE8EE;" FontSize="17" /></Button>
                        <TextBlock Text="{x:Bind Player.RepeatModeText, Mode=OneWay}" Foreground="#E8FFFFFF" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="QualityButton" MinWidth="44" Height="34" Padding="6,0" Style="{StaticResource GhostButtonStyle}" Foreground="White" AutomationProperties.Name="选择音质"><Button.Flyout><Flyout Placement="Top"><Border Background="{StaticResource SurfacePrimaryBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="10"><StackPanel Width="200" Spacing="3"><TextBlock Text="播放音质" Style="{StaticResource PanelTitleTextStyle}" Margin="4,0,4,4" /><Button Content="标准" Tag="Standard" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" /><Button Content="HQ · 高品质" Tag="High" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" /><Button Content="SQ · 超高品质" Tag="VeryHigh" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" /><Button Content="无损" Tag="Lossless" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" /><Button Content="Hi-Res" Tag="HiRes" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" /></StackPanel></Border></Flyout></Button.Flyout><TextBlock Text="{x:Bind Player.QualityLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" /></Button>
                    <FontIcon Glyph="&#xE767;" Foreground="White" FontSize="17" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Width="92" Style="{StaticResource VolumeSliderStyle}" Minimum="0" Maximum="100" Value="{x:Bind Player.VolumePercent, Mode=OneWay}" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="音量" />
                    <Button x:Name="LyricsButton" Style="{StaticResource PlayerIconButtonStyle}" Foreground="White" Click="Lyrics_Click" AutomationProperties.Name="歌词"><FontIcon Glyph="&#xE8D2;" /></Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
