<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Beans.Windows.Rebuild.Models"
    xmlns:playlist="using:Beans.Windows.Rebuild.Controls.PlaylistCard"
    xmlns:track="using:Beans.Windows.Rebuild.Controls.TrackRow">
    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightRailColumn.Width" Value="0" />
                        <Setter Target="RightRail.Visibility" Value="Collapsed" />
                        <Setter Target="PlaylistCard3.Visibility" Value="Collapsed" />
                        <Setter Target="PlaylistCard4.Visibility" Value="Collapsed" />
                        <Setter Target="PlaylistColumn3.Width" Value="0" />
                        <Setter Target="PlaylistColumn4.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1024" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightRailColumn.Width" Value="0" />
                        <Setter Target="RightRail.Visibility" Value="Collapsed" />
                        <Setter Target="PlaylistCard3.Visibility" Value="Visible" />
                        <Setter Target="PlaylistCard4.Visibility" Value="Collapsed" />
                        <Setter Target="PlaylistColumn3.Width" Value="1*" />
                        <Setter Target="PlaylistColumn4.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightRailColumn.Width" Value="280" />
                        <Setter Target="RightRail.Visibility" Value="Visible" />
                        <Setter Target="PlaylistCard3.Visibility" Value="Visible" />
                        <Setter Target="PlaylistCard4.Visibility" Value="Visible" />
                        <Setter Target="PlaylistColumn3.Width" Value="1*" />
                        <Setter Target="PlaylistColumn4.Width" Value="1*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1360" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="RightRailColumn.Width" Value="320" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightRailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,8,28" Spacing="28">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageStatusText" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="刷新" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click" />
                </Grid>
                <Border Height="286" CornerRadius="8" Background="{StaticResource SurfaceSecondaryBrush}">
                    <Grid>
                        <Image Source="{x:Bind ViewModel.HeroImageUri, Mode=OneWay}" Stretch="UniformToFill" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#CE063E35" Offset="0" />
                                    <GradientStop Color="#7A063E35" Offset="0.43" />
                                    <GradientStop Color="#00063E35" Offset="0.82" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Margin="28" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" Style="{StaticResource HeroTitleTextStyle}" TextWrapping="NoWrap" />
                            <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}" FontSize="15" Foreground="#E8FFFFFF" TextWrapping="Wrap" />
                            <Button x:Name="HeroActionButton" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" Click="HeroAction_Click" AutomationProperties.Name="打开首页推荐">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.HeroActionLabel, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="0,0,22,18" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Primary400Brush}" />
                            <Ellipse Width="8" Height="8" Fill="#AFFFFFFF" />
                            <Ellipse Width="8" Height="8" Fill="#AFFFFFFF" />
                            <Ellipse Width="8" Height="8" Fill="#AFFFFFFF" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="推荐歌单" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button Content="查看更多" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="ViewMorePlaylists_Click" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.PlaylistStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <Grid x:Name="PlaylistCardsPanel" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="PlaylistColumn3" Width="*" /><ColumnDefinition x:Name="PlaylistColumn4" Width="*" />
                        </Grid.ColumnDefinitions>
                        <playlist:PlaylistCard x:Name="PlaylistCard1" Grid.Column="0" />
                        <playlist:PlaylistCard x:Name="PlaylistCard2" Grid.Column="1" />
                        <playlist:PlaylistCard x:Name="PlaylistCard3" Grid.Column="2" />
                        <playlist:PlaylistCard x:Name="PlaylistCard4" Grid.Column="3" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="最近播放与推荐" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button Content="查看更多" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="ViewMoreTracks_Click" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.TrackStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <Grid Height="34" Padding="10,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="40" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="歌曲" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="歌手" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="专辑" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="时长" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ListView x:Name="RecentTracksList" ItemsSource="{x:Bind ViewModel.RecentTracks}" ItemContainerStyle="{StaticResource MusicListViewItemStyle}" IsItemClickEnabled="True" ItemClick="RecentTracks_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HomeTrack">
                                <track:TrackRow Index="{x:Bind Index}" Title="{x:Bind Title}" Artist="{x:Bind Artist}" Album="{x:Bind Album}" Duration="{x:Bind Duration}" ImageUri="{x:Bind ImageUri}" SourcePlatform="{x:Bind SourcePlatform}" IsCurrent="{x:Bind IsCurrent}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="TrackEmptyText" Text="{x:Bind ViewModel.TrackStatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="RightRail" Grid.Column="1" Margin="8,24,24,28" Background="#BFFFFFFF" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="20" Spacing="18">
                    <TextBlock Text="正在播放" Style="{StaticResource PanelTitleTextStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="7" Background="{StaticResource SurfaceSecondaryBrush}"><Image Source="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" MaxLines="1" />
                            <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" MaxLines="1" />
                            <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left"><TextBlock Text="{x:Bind Player.QualityLabel, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Primary700Brush}" /></Border>
                            <TextBlock Text="{x:Bind Player.SourceLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="Favorite_Click" AutomationProperties.Name="收藏当前歌曲"><FontIcon Glyph="&#xEB51;" FontSize="17" Foreground="{StaticResource Primary600Brush}" /></Button>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="22" /></Grid.RowDefinitions>
                        <Slider Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource MusicSliderStyle}" IsHitTestVisible="False" Minimum="0" Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" AutomationProperties.Name="当前播放进度" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Player.PositionText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Player.DurationText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Style="{StaticResource IconButtonStyle}" Click="Shuffle_Click" AutomationProperties.Name="随机播放"><FontIcon Glyph="&#xE8B1;" FontSize="17" /></Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="Previous_Click" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="18" /></Button>
                        <Button Style="{StaticResource MainPlayButtonStyle}" Click="PlayPause_Click" AutomationProperties.Name="播放或暂停"><FontIcon Glyph="{x:Bind Player.PlayPauseGlyph, Mode=OneWay}" FontSize="21" /></Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="Next_Click" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="18" /></Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="Repeat_Click" AutomationProperties.Name="循环模式"><FontIcon Glyph="&#xE8EE;" FontSize="17" /></Button>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />
                    <TextBlock Text="相似推荐" Style="{StaticResource PanelTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RecommendationStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <ListView x:Name="RecommendationList" ItemsSource="{x:Bind ViewModel.Recommendations}" ItemContainerStyle="{StaticResource MusicListViewItemStyle}" IsItemClickEnabled="True" ItemClick="Recommendations_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HomeRecommendation">
                                <Grid Height="54" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="5"><Image Source="{x:Bind ImageUri}" Stretch="UniformToFill" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" />
                                        <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />
                    <Grid>
                        <TextBlock Text="本机音乐库" Style="{StaticResource PanelTitleTextStyle}" />
                        <Button Content="查看" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="ViewLibrary_Click" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.FavoriteSummaryText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
