<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Ranking.RankingDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Beans.Windows.Rebuild.Pages.Artist"
    xmlns:badge="using:Beans.Windows.Rebuild.Controls.PlatformBadge">
    <Grid Background="{StaticResource ContentBackgroundBrush}"><ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,32" Spacing="22">
        <Grid ColumnSpacing="22"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="240" Height="180" CornerRadius="8"><Image Source="{x:Bind CoverUri}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9"><TextBlock Text="排行榜" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind Title}" Style="{StaticResource PageTitleTextStyle}" TextWrapping="Wrap" /><badge:PlatformBadge Platform="{x:Bind Platform}" HorizontalAlignment="Left" /><TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxLines="3" /><TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" /></StackPanel></Grid>
        <TextBlock Text="榜单歌曲" Style="{StaticResource SectionTitleTextStyle}" /><Border Style="{StaticResource SurfacePanelStyle}" Padding="8"><ListView ItemsSource="{x:Bind Tracks}" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:DetailTrackPreview"><Grid MinHeight="64" Padding="10,5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Text="#" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Album}" Style="{StaticResource CaptionTextStyle}" /></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Artist}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{x:Bind Duration}" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" /><TextBlock Grid.Column="4" Text="{x:Bind RestrictionState}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
    </StackPanel></ScrollViewer></Grid>
</UserControl>
