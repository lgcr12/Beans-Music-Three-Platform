<UserControl x:Class="Beans.Windows.Rebuild.Pages.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,12,28,28" ColumnSpacing="22" SizeChanged="Settings_SizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="280"/></Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <TextBlock Text="设置" FontSize="34" FontWeight="Bold"/>
                <Border Style="{StaticResource SurfacePanelStyle}" Padding="22">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="外观" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="选择你喜欢的主题风格" Style="{StaticResource CaptionTextStyle}"/></StackPanel><ToggleSwitch x:Name="AppearanceToggle" Grid.Column="1" Header="深色外观" Toggled="Appearance_Toggled"/></Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                            <Button Click="DarkTheme_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" CornerRadius="12"><StackPanel Spacing="10"><Border Height="108" CornerRadius="8"><Image Source="ms-appx:///Assets/Home/aurora-shell.png" Stretch="UniformToFill"/></Border><TextBlock Text="极光青" Margin="4,0" FontWeight="SemiBold"/></StackPanel></Button>
                            <Button Grid.Column="1" Click="LightTheme_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" CornerRadius="12"><StackPanel Spacing="10"><Border Height="108" CornerRadius="8"><Image Source="ms-appx:///Assets/Player/Backgrounds/mist.png" Stretch="UniformToFill"/></Border><TextBlock Text="浅色雾光" Margin="4,0" FontWeight="SemiBold"/></StackPanel></Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfacePanelStyle}" Padding="22">
                    <StackPanel Spacing="18">
                        <TextBlock Text="播放器" Style="{StaticResource SectionTitleTextStyle}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
                            <StackPanel Spacing="8"><TextBlock Text="默认音量" FontWeight="SemiBold"/><TextBlock Text="立即调整并保存在本机" Style="{StaticResource CaptionTextStyle}"/><Slider x:Name="DefaultVolumeSlider" Minimum="0" Maximum="100" Style="{StaticResource MusicSliderStyle}" ValueChanged="Volume_ValueChanged"/></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="减少动效" FontWeight="SemiBold"/><TextBlock Text="降低歌词页背景动画" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/><ToggleSwitch x:Name="ReduceMotionToggle" Toggled="LyricsSettings_Changed"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfacePanelStyle}" Padding="22">
                    <StackPanel Spacing="18">
                        <TextBlock Text="歌词" Style="{StaticResource SectionTitleTextStyle}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
                            <StackPanel Spacing="8"><TextBlock Text="歌词字号" FontWeight="SemiBold"/><Slider x:Name="LyricScaleSlider" Minimum="0.8" Maximum="1.4" Value="1" StepFrequency="0.05" Style="{StaticResource MusicSliderStyle}" ValueChanged="LyricScale_Changed"/><TextBlock Text="预览即时更新，打开播放器后应用" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="翻译显示" FontWeight="SemiBold"/><ToggleSwitch x:Name="TranslationToggle" IsOn="True" Toggled="LyricsSettings_Changed"/><TextBlock Text="歌曲有翻译时显示" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Expander Header="隐私与存储" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10"><TextBlock Text="音乐文件只保存在本机，不会上传到 Beans 服务。" TextWrapping="Wrap"/><TextBlock Text="在线平台凭证仅保存在 Windows Credential Locker；匿名请求不携带账号凭证。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel></Expander>
                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="PreviewPanel" Grid.Column="1" Style="{StaticResource SurfacePanelStyle}" Padding="22" VerticalAlignment="Stretch">
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="5"><TextBlock Text="预览效果" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="当前歌曲与歌词排版预览" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                    <Border Height="196" CornerRadius="12" Background="#29495B"><Grid><Image Source="ms-appx:///Assets/Home/aurora-shell.png" Stretch="UniformToFill"/><Image Source="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Spacing="5"><TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
                    <ProgressBar Minimum="0" Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" Foreground="{StaticResource Primary400Brush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"><Button Style="{StaticResource IconButtonStyle}" Click="Previous_Click" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;"/></Button><Button Style="{StaticResource MainPlayButtonStyle}" Click="PlayPause_Click" AutomationProperties.Name="播放或暂停"><FontIcon Glyph="{x:Bind Player.PlayPauseGlyph, Mode=OneWay}"/></Button><Button Style="{StaticResource IconButtonStyle}" Click="Next_Click" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;"/></Button></StackPanel>
                    <Border Padding="12,28" Background="#5023485B" CornerRadius="14"><StackPanel Spacing="20"><TextBlock Text="歌词排版示例" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewLyric" Text="走向光的方向" FontSize="24" Foreground="{StaticResource Primary400Brush}" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="PreviewTranslation" Text="Towards the light" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/><TextBlock Text="每一个音符都值得聆听" Opacity="0.5" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
