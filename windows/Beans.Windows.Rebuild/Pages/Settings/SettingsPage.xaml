<UserControl x:Class="Beans.Windows.Rebuild.Pages.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource ContentBackgroundBrush}"><ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" Spacing="20">
        <StackPanel Spacing="5"><TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="管理 Beans Music 的外观、播放和隐私偏好" Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
        <Border Style="{StaticResource SurfacePanelStyle}" Padding="18"><StackPanel Spacing="16"><TextBlock Text="外观" Style="{StaticResource SectionTitleTextStyle}"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Grid.Column="0"><TextBlock Text="深色外观" FontWeight="SemiBold"/><TextBlock Text="立即切换当前窗口的深色或浅色纸感主题，并保存在本机" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="AppearanceToggle" Grid.Column="1" HorizontalAlignment="Right" Toggled="Appearance_Toggled" AutomationProperties.Name="切换深色外观"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Grid.Column="0"><TextBlock Text="紧凑布局" FontWeight="SemiBold"/><TextBlock Text="当前版本暂不支持紧凑布局" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsEnabled="False" HorizontalAlignment="Right" AutomationProperties.Name="紧凑布局，当前不可用"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource SurfacePanelStyle}" Padding="18"><StackPanel Spacing="16"><TextBlock Text="播放" Style="{StaticResource SectionTitleTextStyle}"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Grid.Column="0"><TextBlock Text="启动时恢复上次队列" FontWeight="SemiBold"/><TextBlock Text="当前版本暂不支持自动恢复队列" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsEnabled="False" HorizontalAlignment="Right" AutomationProperties.Name="恢复上次队列，当前不可用"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Grid.Column="0"><TextBlock Text="默认音量" FontWeight="SemiBold"/><TextBlock Text="立即调整播放器音量并保存在本机" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/></StackPanel><Slider x:Name="DefaultVolumeSlider" Grid.Column="1" Width="180" HorizontalAlignment="Right" Value="72" Minimum="0" Maximum="100" ValueChanged="Volume_ValueChanged"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource SurfacePanelStyle}" Padding="18"><StackPanel Spacing="10"><TextBlock Text="隐私" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="本地音乐文件、目录和歌词只保存在本机，不会上传到 Beans 服务。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/><TextBlock Text="在线平台凭证仅保存在 Windows Credential Locker；匿名公开请求不会携带账号 Cookie。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
    </StackPanel></ScrollViewer></Grid>
</UserControl>
