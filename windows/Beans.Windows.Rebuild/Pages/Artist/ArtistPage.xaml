<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Artist.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Beans.Windows.Rebuild.Pages.Artist"
    xmlns:badge="using:Beans.Windows.Rebuild.Controls.PlatformBadge">
    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,32" Spacing="22">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="180" Height="180" CornerRadius="8" Background="{StaticResource SurfaceSecondaryBrush}"><Image Source="{x:Bind ArtistContent.ImageUri}" Stretch="UniformToFill" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                        <TextBlock Text="歌手" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{x:Bind ArtistContent.Name}" Style="{StaticResource PageTitleTextStyle}" TextWrapping="Wrap" />
                        <badge:PlatformBadge Platform="{x:Bind ArtistContent.Platform}" HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Bind ArtistContent.Description}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxWidth="660" />
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="热门歌曲" Style="{StaticResource SectionTitleTextStyle}" />
                <Border Style="{StaticResource SurfacePanelStyle}" Padding="8">
                    <ListView ItemsSource="{x:Bind ArtistContent.Tracks}" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:DetailTrackPreview"><Grid MinHeight="62" Padding="10,5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="80" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Album}" Style="{StaticResource CaptionTextStyle}" /></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind Artist}" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Column="2" Text="{x:Bind Duration}" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" /><TextBlock Grid.Column="3" Text="{x:Bind RestrictionState}" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Border>
                <TextBlock Text="专辑" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind ArtistContent.Albums}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DetailAlbumPreview"><StackPanel Width="180" Margin="0,0,16,16" Spacing="7"><Border Width="180" Height="132" CornerRadius="6"><Image Source="{x:Bind CoverUri}" Stretch="UniformToFill" /></Border><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" /><TextBlock Text="{x:Bind Year}" Style="{StaticResource CaptionTextStyle}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
