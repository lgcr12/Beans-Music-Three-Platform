<UserControl x:Class="Beans.Windows.Rebuild.Pages.Accounts.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" SizeChanged="Root_SizeChanged">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,18,32,32" Spacing="20" MaxWidth="1280">
                <TextBlock Text="账号与平台" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Style="{StaticResource SurfacePanelStyle}" Padding="24" MinHeight="148">
                    <Grid x:Name="BeansCard" ColumnDefinitions="72,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="22" RowSpacing="18">
                        <Border Width="72" Height="72" CornerRadius="36" Background="#305DDDAD" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/Branding/beans-icon.png" Width="52" Height="52"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7"><TextBlock Text="Beans 账户" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="收藏音乐，连接你的音乐生活" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind BeansStatus, Mode=OneWay}" Foreground="{StaticResource Primary400Brush}" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel x:Name="BeansActions" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="登录" Click="OpenBeansForm_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90"/>
                            <Button Content="注册" Click="OpenBeansForm_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90"/>
                            <Button Content="同步数据" Click="SyncBeans_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Expander x:Name="BeansForm" Header="Beans 账号登录与注册" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                    <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Stretch">
                        <TextBox x:Name="ServerBox" Header="账号服务地址" Text="http://localhost:8080/"/>
                        <TextBox x:Name="NicknameBox" Header="昵称" PlaceholderText="注册时填写"/>
                        <TextBox x:Name="EmailBox" Header="邮箱" InputScope="EmailSmtpAddress"/>
                        <PasswordBox x:Name="PasswordBox" Header="密码"/>
                        <TextBox x:Name="VerificationBox" Header="邮箱验证码"/>
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="166" ItemHeight="48">
                            <Button Content="登录" Click="LoginBeans_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="注册 Beans 账号" Click="RegisterBeans_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="验证邮箱" Click="VerifyBeans_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="退出 Beans 账号" Click="LogoutBeans_Click" Style="{StaticResource GhostButtonStyle}"/>
                        </VariableSizedWrapGrid>
                    </StackPanel>
                </Expander>

                <Border Style="{StaticResource SurfacePanelStyle}" Padding="24" MinHeight="142">
                    <Grid x:Name="QqCard" ColumnSpacing="22" RowSpacing="18" ColumnDefinitions="72,*,Auto" RowDefinitions="Auto,Auto">
                        <Border Width="72" Height="72" CornerRadius="36" Background="#BC9B7C0A" VerticalAlignment="Center"><FontIcon Glyph="&#xE8D6;" FontSize="34" Foreground="White"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                            <TextBlock Text="QQ 音乐" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind QqStatus, Mode=OneWay}" Foreground="{StaticResource Primary400Brush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind QqProbeDetail, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="QqActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Button Content="授权" Tag="qq" Click="Login_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90"/>
                            <Button Content="刷新状态" Click="RefreshProbe_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="退出登录" Tag="qq" Click="Logout_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SurfacePanelStyle}" Padding="24" MinHeight="142">
                    <Grid x:Name="NetEaseCard" ColumnSpacing="22" RowSpacing="18" ColumnDefinitions="72,*,Auto" RowDefinitions="Auto,Auto">
                        <Border Width="72" Height="72" CornerRadius="36" Background="#BCCA283D" VerticalAlignment="Center"><FontIcon Glyph="&#xE8D6;" FontSize="34" Foreground="White"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                            <TextBlock Text="网易云音乐" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind NetEaseStatus, Mode=OneWay}" Foreground="{StaticResource Primary400Brush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind NetEaseProbeDetail, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="NetEaseActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <Button Content="授权" Tag="netease" Click="Login_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90"/>
                            <Button Content="刷新状态" Click="RefreshProbe_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="退出登录" Tag="netease" Click="Logout_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <InfoBar IsOpen="True" Severity="Informational" Message="{x:Bind StatusText, Mode=OneWay}"/>
                <TextBlock Text="平台授权保存在本机。音乐文件不会上传到 Beans 服务。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
