<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Accounts.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:badge="using:Beans.Windows.Rebuild.Controls.PlatformBadge">
    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="20" MaxWidth="1120" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="账号与平台" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="平台授权保存在本机；Beans 账号用于端到端加密的数据同步。"
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新探针" Click="RefreshProbe_Click"
                            Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                </Grid>

                <InfoBar IsOpen="True" Severity="Informational" Message="{x:Bind StatusText, Mode=OneWay}" />

                <StackPanel Spacing="12">
                    <TextBlock Text="在线平台" Style="{StaticResource SectionTitleTextStyle}" />
                    <Border Style="{StaticResource SurfacePanelStyle}" Padding="18">
                        <StackPanel Spacing="18">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                <badge:PlatformBadge Platform="{x:Bind QqPlatform}" Grid.RowSpan="2" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="QQ 音乐" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind QqStatus, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind QqProbeDetail, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="登录 QQ 音乐" MinWidth="116" Style="{StaticResource SecondaryButtonStyle}" Click="Login_Click" Tag="qq" />
                                    <Button Content="退出" MinWidth="72" Click="Logout_Click" Tag="qq" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                <badge:PlatformBadge Platform="{x:Bind NetEasePlatform}" Grid.RowSpan="2" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="网易云音乐" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind NetEaseStatus, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind NetEaseProbeDetail, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="登录网易云" MinWidth="116" Style="{StaticResource SecondaryButtonStyle}" Click="Login_Click" Tag="netease" />
                                    <Button Content="退出" MinWidth="72" Click="Logout_Click" Tag="netease" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Beans 账号" Style="{StaticResource SectionTitleTextStyle}" />
                    <Border Style="{StaticResource SurfacePanelStyle}" Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{x:Bind BeansStatus, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBox x:Name="ServerBox" Header="账号服务地址" Text="http://localhost:8080/" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <TextBox x:Name="NicknameBox" Header="昵称" PlaceholderText="注册时填写" />
                                <TextBox x:Name="EmailBox" Grid.Column="1" Header="邮箱" InputScope="EmailSmtpAddress" />
                            </Grid>
                            <PasswordBox x:Name="PasswordBox" Header="密码" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBox x:Name="VerificationBox" Header="邮箱验证码" />
                                <Button Grid.Column="1" Content="验证邮箱" Click="VerifyBeans_Click"
                                        VerticalAlignment="Bottom" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Button Content="注册 Beans 账号" Click="RegisterBeans_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="登录" Click="LoginBeans_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Content="立即同步" Click="SyncBeans_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="1" Content="退出" Click="LogoutBeans_Click" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SurfacePanelStyle}" Padding="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <badge:PlatformBadge Platform="{x:Bind LocalPlatform}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="本地音乐" FontWeight="SemiBold" />
                            <TextBlock Text="无需登录；本地文件不会上传到平台或 Beans 服务。"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
