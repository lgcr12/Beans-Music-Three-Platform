<UserControl x:Class="Beans.Windows.Rebuild.Pages.Notifications.NotificationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="5"><TextBlock Text="通知" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="查看 Beans Music 的系统和同步提醒" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/></StackPanel>
            <Border Style="{StaticResource SurfacePanelStyle}" Padding="32">
                <StackPanel HorizontalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE7E7;" FontSize="32" Foreground="{StaticResource TextTertiaryBrush}"/><TextBlock Text="暂无新通知" Style="{StaticResource PanelTitleTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="当扫描、授权或同步需要你处理时，提醒会显示在这里。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
