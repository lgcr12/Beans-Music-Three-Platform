<UserControl x:Class="Beans.Windows.Rebuild.Pages.Anime.AnimeShell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Light">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Styles/Anime.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="Root" RowDefinitions="72,*,88">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#88BDF0" Offset="0"/><GradientStop Color="#ECF6FF" Offset="0.7"/></LinearGradientBrush></Grid.Background>
  <Image x:Name="Backdrop" Grid.RowSpan="2" Height="390" VerticalAlignment="Top" Source="ms-appx:///Assets/Home/Anime/anime-hero-ultrawide-v1.png" HorizontalAlignment="Stretch" Stretch="Fill" IsHitTestVisible="False"/>
  <Border x:Name="BackdropWash" Grid.RowSpan="2" Height="390" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00EDF6FF" Offset="0"/><GradientStop Color="#10EDF6FF" Offset="0.3"/><GradientStop Color="#64EDF6FF" Offset="0.78"/><GradientStop Color="#D9EDF6FF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <Border x:Name="LeftWash" Grid.RowSpan="2" Height="390" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#DDE5F3FF" Offset="0"/><GradientStop Color="#CBE5F3FF" Offset="0.33"/><GradientStop Color="#25E5F3FF" Offset="0.72"/></LinearGradientBrush></Border.Background></Border>
  <Grid x:Name="Header" Padding="28,20,160,8" ColumnDefinitions="Auto,*,Auto">
   <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource AnimeIconButtonStyle}" AutomationProperties.Name="返回音乐首页"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><Image Source="ms-appx:///Assets/Branding/beans-icon.png" Width="26" Height="26"/><TextBlock x:Name="Brand" Text="Beans Music" FontSize="18" FontWeight="SemiBold" Foreground="#27466D" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"><Button x:Name="HomeNav" Content="放送首页" Tag="home" Click="Nav_Click" Style="{StaticResource AnimeButtonStyle}"/><Button x:Name="IndexNav" Content="番剧索引" Tag="index" Click="Nav_Click" Style="{StaticResource AnimeButtonStyle}"/><Button x:Name="FavoritesNav" Content="我的收藏" Tag="favorites" Click="Nav_Click" Style="{StaticResource AnimeButtonStyle}"/></StackPanel>
   <Button x:Name="MotionButton" Grid.Column="2" Click="Motion_Click" Style="{StaticResource AnimeIconButtonStyle}" AutomationProperties.Name="切换减少动效"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
  </Grid>
  <Border x:Name="TitleBarDrag" Grid.ColumnSpan="3" Height="16" VerticalAlignment="Top" Background="Transparent"/>
  <Grid Grid.Row="1" RowDefinitions="Auto,*"><Border x:Name="NoticeHost" Margin="32,0,32,4" Padding="12,6" Background="#DDEDF5FF" CornerRadius="8" Visibility="Collapsed"><TextBlock x:Name="Notice" Foreground="#365C88" TextWrapping="Wrap" FontSize="12"/></Border><ContentControl x:Name="ViewHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Grid>
  <Border x:Name="PlayerSurface" Grid.Row="2" BorderBrush="#75FFFFFF" BorderThickness="1,1,1,0" Padding="24,10" CornerRadius="18,18,0,0" Margin="10,0,10,0">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E68A9FF0" Offset="0"/><GradientStop Color="#E675B7E8" Offset="0.52"/><GradientStop Color="#E89C8DEB" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="22">
    <Grid ColumnDefinitions="76,*" ColumnSpacing="12" VerticalAlignment="Center" Tapped="OpenPlayer_Tapped" ToolTipService.ToolTip="打开沉浸式播放器" AutomationProperties.Name="打开沉浸式播放器">
     <Grid Width="70" Height="70">
      <Ellipse Fill="#661D3D76" Stroke="#88FFFFFF" StrokeThickness="1" />
      <Ellipse Width="54" Height="54" Fill="#CC243D72" Stroke="#55FFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Ellipse Width="12" Height="12" Fill="#FFF4C7E6" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#20709AD4" BorderBrush="#E6FFFFFF" BorderThickness="2">
       <Image x:Name="PlayerArtwork" Source="{x:Bind Player.ArtworkUri,Mode=OneWay}" Stretch="UniformToFill" />
      </Border>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFF7D66E" BorderBrush="#AAFFFFFF" BorderThickness="1" CornerRadius="8" Padding="5,2" Rotation="-8">
       <TextBlock Text="ANIME" Foreground="#6C4A93" FontSize="8" FontWeight="Bold" />
      </Border>
      <FontIcon x:Name="EmptyArtwork" Glyph="&#xE8D6;" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Grid>
     <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
      <TextBlock x:Name="PlayerTitle" Text="{x:Bind Player.Title,Mode=OneWay}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="PlayerArtist" Text="{x:Bind Player.Artist,Mode=OneWay}" Foreground="#F0EDFF" FontSize="11" TextTrimming="CharacterEllipsis" />
      <Border Background="#38FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left"><TextBlock Text="主题曲 · 播放中" Foreground="#FFFDFE" FontSize="9" /></Border>
     </StackPanel>
    </Grid>
    <Grid Grid.Column="1" Width="360" RowDefinitions="44,20">
     <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center"><Button x:Name="ShuffleButton" Click="Shuffle_Click" Style="{StaticResource AnimeStickerButtonStyle}" AutomationProperties.Name="随机播放"><FontIcon Glyph="&#xE8B1;" FontSize="16"/></Button><Button x:Name="PreviousButton" Click="Previous_Click" Style="{StaticResource AnimeStickerButtonStyle}" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="18"/></Button><Button x:Name="PlayButton" Click="Toggle_Click" Style="{StaticResource AnimeIconButtonStyle}" Background="#FFFDF4FF" Foreground="#7C5BEA" Width="46" Height="46" CornerRadius="23" AutomationProperties.Name="播放或暂停"><FontIcon Glyph="{x:Bind Player.PlayPauseGlyph,Mode=OneWay}" FontSize="20"/></Button><Button x:Name="NextButton" Click="Next_Click" Style="{StaticResource AnimeStickerButtonStyle}" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="18"/></Button><Button x:Name="RepeatButton" Click="Repeat_Click" Style="{StaticResource AnimeStickerButtonStyle}" AutomationProperties.Name="循环模式"><FontIcon Glyph="&#xE8EE;" FontSize="16"/></Button></StackPanel>
     <Grid Grid.Row="1" ColumnDefinitions="36,*,36" ColumnSpacing="8"><TextBlock x:Name="Elapsed" Text="{x:Bind Player.PositionText,Mode=OneWay}" FontSize="10" Foreground="#E9F4FF" VerticalAlignment="Center"/><Slider x:Name="Progress" Grid.Column="1" Minimum="0" Maximum="1" Value="{x:Bind Player.PositionSeconds,Mode=OneWay}" Style="{StaticResource AnimeSliderStyle}" Foreground="White" Background="#558EB6E8" AutomationProperties.Name="播放进度"/><TextBlock x:Name="DurationLabel" Grid.Column="2" Text="{x:Bind Player.DurationText,Mode=OneWay}" FontSize="10" Foreground="#E9F4FF" VerticalAlignment="Center"/></Grid>
    </Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="LyricsButton" Click="Lyrics_Click" Style="{StaticResource AnimeIconButtonStyle}" Foreground="White" AutomationProperties.Name="歌词"><FontIcon Glyph="&#xE8D2;" FontSize="17"/></Button><FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="17" Foreground="White"/><Slider x:Name="Volume" Width="94" Minimum="0" Maximum="100" Value="{x:Bind Player.VolumePercent,Mode=OneWay}" ValueChanged="Volume_Changed" Style="{StaticResource AnimeSliderStyle}" Foreground="White" AutomationProperties.Name="音量"/><Button x:Name="QueueButton" Click="Queue_Click" Style="{StaticResource AnimeIconButtonStyle}" Foreground="White" AutomationProperties.Name="队列"><FontIcon Glyph="&#xE142;" FontSize="19"/></Button></StackPanel>
   </Grid>
  </Border>
  <ContentControl x:Name="LyricsHost" Grid.RowSpan="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</UserControl>
