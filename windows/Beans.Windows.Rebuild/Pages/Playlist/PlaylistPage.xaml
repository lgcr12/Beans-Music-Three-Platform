<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Playlist.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Beans.Windows.Rebuild.Pages.Library"
    xmlns:badge="using:Beans.Windows.Rebuild.Controls.PlatformBadge">
    <Grid Background="Transparent" SizeChanged="Playlist_SizeChanged">


        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,8,28,24" Spacing="16">
                <Button Content="‹  返回" Style="{StaticResource GhostButtonStyle}" Click="Back_Click" HorizontalAlignment="Left"/>
                <Border x:Name="PlaylistHero" MinHeight="224" Background="Transparent">
                    <Grid>
                        <Grid Padding="0,8" ColumnSpacing="28">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CoverColumn" Width="196" /><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                            <Border x:Name="PlaylistCover" Width="196" Height="196" CornerRadius="12" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="#35FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                <Image Source="{x:Bind Details.Playlist.CoverUri}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="10" MaxWidth="720">

                                <TextBlock Text="{x:Bind Details.Playlist.Title}" Foreground="White" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <badge:PlatformBadge Platform="{x:Bind Details.Playlist.Platform}" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Details.Playlist.TrackCount}" Foreground="#D0FFFFFF" FontSize="13" />
                                        <TextBlock Text="首歌曲" Foreground="#D0FFFFFF" FontSize="13" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Details.Playlist.Description}" Foreground="#D8FFFFFF" FontSize="14" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{x:Bind Details.Description}" Foreground="#9FFFFFFF" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="PlayAll_Click" IsEnabled="{x:Bind Details.CanAttemptPlayback}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" /><TextBlock Text="播放全部" /></StackPanel></Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="RandomPlay_Click" IsEnabled="{x:Bind Details.CanAttemptPlayback}" AutomationProperties.Name="随机播放此歌单"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B1;" /><TextBlock Text="随机播放" /></StackPanel></Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="QueueAll_Click" IsEnabled="{x:Bind Details.CanAttemptPlayback}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8FD;" /><TextBlock Text="加入队列" /></StackPanel></Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="ImportToBeans_Click" IsEnabled="{x:Bind CanImportToBeans}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE898;" /><TextBlock Text="导入到 Beans" /></StackPanel></Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{x:Bind Details.Description}" Foreground="#A8FFFFFF" FontSize="11" TextAlignment="Right" MaxWidth="180" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="#D8FFFFFF" FontSize="12" TextAlignment="Right" MaxWidth="220" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="PlaylistToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12" Background="#70133345" Padding="14" CornerRadius="16">

                    <Border Height="42" Padding="11,0" CornerRadius="21"
                            Background="{StaticResource SurfaceSecondaryBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="TrackFilterBox" Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                     PlaceholderText="搜索歌曲、歌手或专辑" TextChanged="TrackFilter_TextChanged"
                                     AutomationProperties.Name="筛选歌单歌曲" />
                            <Button x:Name="FilterClearButton" Grid.Column="2" Width="28" Height="28" MinHeight="28" Padding="0"
                                    CornerRadius="14" Style="{StaticResource IconButtonStyle}" Click="ClearFilter_Click"
                                    Visibility="{x:Bind FilterClearVisibility, Mode=OneWay}"
                                    AutomationProperties.Name="清除歌单筛选" ToolTipService.ToolTip="清除筛选">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="SelectionActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind FilteredCountText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <CheckBox x:Name="SelectAllCheckBox" Content="全选" IsThreeState="True" Click="SelectAll_Click"
                                  VerticalAlignment="Center" AutomationProperties.Name="全选当前筛选结果" />
                        <TextBlock Text="{x:Bind SelectionText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <Button Content="清除选择" Style="{StaticResource GhostButtonStyle}" Click="ClearSelection_Click" />

                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource SurfacePanelStyle}" Padding="10" CornerRadius="12">
                    <StackPanel Spacing="8">
                    <Grid Padding="10,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="歌曲" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Column="3" Text="专辑" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Column="4" Text="时长" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Column="5" Text="来源与播放状态" Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                    <ListView ItemsSource="{x:Bind FilteredTracks, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="None" MaxHeight="520" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryTrackPreview">
                                <Border Padding="10,5" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid MinHeight="48" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="56" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CheckBox Tag="{x:Bind Id}" Click="TrackSelect_Click" VerticalAlignment="Center" AutomationProperties.Name="选择歌曲" />
                                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="6" Background="{StaticResource SurfaceSecondaryBrush}"><Image Source="{x:Bind CoverUri}" Stretch="UniformToFill" /></Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Album}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Duration}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{x:Bind PlatformLabel}" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind PlaybackBoundary}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" MaxLines="2" /></StackPanel>
                                        <Button Grid.Column="6" Content="播放" Style="{StaticResource GhostButtonStyle}" Click="TrackAction_Click" IsEnabled="{x:Bind CanAttemptPlayback}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="没有匹配的歌曲" Visibility="{x:Bind NoFilterResultsVisibility, Mode=OneWay}"
                               Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,18" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPanelStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="重新加载" Style="{StaticResource GhostButtonStyle}" Click="Retry_Click" AutomationProperties.Name="重新加载歌单详情" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
