<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Beans.Windows.Rebuild.Models"
    xmlns:badge="using:Beans.Windows.Rebuild.Controls.PlatformBadge">
    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Margin="24" Spacing="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Click="Back_Click" AutomationProperties.Name="返回"><FontIcon Glyph="&#xE72B;" FontSize="17" /></Button>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="QueryTitle" Style="{StaticResource PageTitleTextStyle}" Text="搜索" />
                        <TextBlock x:Name="ResultSummary" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="Refresh_Click" AutomationProperties.Name="刷新搜索"><FontIcon Glyph="&#xE72C;" FontSize="17" /></Button>
                </Grid>

                <Border x:Name="SuggestionsPanel" Visibility="Collapsed" Style="{StaticResource SurfacePanelStyle}" Padding="10">
                    <ListView x:Name="SuggestionList" ItemsSource="{x:Bind ViewModel.Suggestions}" IsItemClickEnabled="True" ItemClick="Suggestion_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchSuggestion">
                                <Grid Padding="8,5" ColumnSpacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Text}" MaxLines="1" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="来源范围" Style="{StaticResource CaptionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AggregateScopeButton" Content="综合" Tag="Aggregate" Click="Scope_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="QqScopeButton" Content="QQ 音乐" Tag="Qq" Click="Scope_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button x:Name="NetEaseScopeButton" Content="网易云音乐" Tag="NetEase" Click="Scope_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button x:Name="LocalScopeButton" Content="本地音乐" Tag="Local" Click="Scope_Click" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="结果类型" Style="{StaticResource CaptionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AllFilterButton" Content="全部" Tag="All" Click="Filter_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="TracksFilterButton" Content="歌曲" Tag="Tracks" Click="Filter_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button x:Name="AlbumsFilterButton" Content="专辑" Tag="Albums" Click="Filter_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button x:Name="ArtistsFilterButton" Content="歌手" Tag="Artists" Click="Filter_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button x:Name="PlaylistsFilterButton" Content="歌单" Tag="Playlists" Click="Filter_Click" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SourceRailColumn" Width="270" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SurfacePanelStyle}" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="搜索结果" Style="{StaticResource PanelTitleTextStyle}" />
                                <TextBlock x:Name="PartialHint" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                            </Grid>
                            <Grid Height="32" Padding="10,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="60" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="内容" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="歌手" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="专辑 / 说明" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="来源" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="音质" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="时长" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="ResultsList" ItemsSource="{x:Bind ViewModel.Results}" IsItemClickEnabled="True" ItemClick="Result_ItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource MusicListViewItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SearchResultItem">
                                        <Grid Height="62" Padding="10,0" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="60" /><ColumnDefinition Width="60" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource SurfaceSecondaryBrush}"><Image Source="{x:Bind CoverUri}" Stretch="UniformToFill" /></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" />
                                                <TextBlock Text="{x:Bind ResultTypeLabel}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Artist}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" MaxLines="1" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Album}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" MaxLines="1" />
                                            <badge:PlatformBadge Grid.Column="4" Platform="{x:Bind Platform}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Quality}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="7" Tag="{x:Bind}" Style="{StaticResource IconButtonStyle}" Click="More_Click" AutomationProperties.Name="更多操作"><FontIcon Glyph="&#xE712;" FontSize="15" /></Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border x:Name="LoadingPanel" Visibility="Collapsed" Padding="24"><StackPanel HorizontalAlignment="Center" Spacing="8"><ProgressRing IsActive="True" Foreground="{StaticResource Primary600Brush}" /><TextBlock Text="正在搜索" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></Border>
                            <Border x:Name="EmptyPanel" Visibility="Collapsed" Padding="24"><TextBlock x:Name="EmptyText" Text="没有匹配结果" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" /></Border>
                            <Border x:Name="NoticePanel" Visibility="Collapsed" Padding="12" Background="{StaticResource Primary050Brush}" BorderBrush="{StaticResource Primary200Brush}" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="NoticeText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SourceRail" Grid.Column="1" Style="{StaticResource SurfacePanelStyle}" Padding="16" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <TextBlock Text="搜索来源" Style="{StaticResource PanelTitleTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SearchSourceStatus">
                                        <Grid Margin="0,3" ColumnSpacing="8">
                                            <badge:PlatformBadge Platform="{x:Bind Platform}" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="1" Margin="92,0,0,0" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayLine}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind SafeMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LocalBoundaryText" Text="本地音乐 · 尚未添加本地目录" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
