<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.QueueLyrics.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyrics="using:Beans.Windows.Rebuild.Pages.QueueLyrics">
    <Grid Background="{StaticResource ContentBackgroundBrush}" Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="8" Background="{StaticResource SurfaceSecondaryBrush}" VerticalAlignment="Center">
                <Image Source="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="歌词" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="TrackContextText" Text="选择歌曲后显示本地歌词" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                    <ProgressBar Grid.Column="1" Height="3" VerticalAlignment="Center" Minimum="0" Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Player.DurationText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                </Grid>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Padding="10,5" VerticalAlignment="Center">
                <TextBlock x:Name="SourceText" Text="未选择来源" Style="{StaticResource CaptionTextStyle}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfacePanelStyle}" Padding="8" MinHeight="280">
            <Grid>
                <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                    <ProgressRing x:Name="LoadingRing" Width="30" Height="30" IsActive="False" Visibility="Collapsed" />
                    <FontIcon x:Name="StateIcon" Glyph="&#xE8D2;" FontSize="32" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock x:Name="StateTitle" Text="尚未选择歌曲" Style="{StaticResource PanelTitleTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="StateMessage" Text="当前歌曲没有可显示的歌词内容。" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="RetryButton" Content="重试" Style="{StaticResource SecondaryButtonStyle}" Click="Retry_Click" Visibility="Collapsed" HorizontalAlignment="Center" />
                </StackPanel>

                <ListView
                    x:Name="LyricList"
                    ItemsSource="{x:Bind Lines}"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    HorizontalContentAlignment="Stretch"
                    Visibility="Collapsed"
                    AutomationProperties.Name="歌词时间轴">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lyrics:LyricLineRow">
                                <Grid MinHeight="64" Padding="18,8" ColumnSpacing="16" Background="{StaticResource SurfacePrimaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Primary600Brush}" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind TimestampText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Text}" FontSize="17" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Translation}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
