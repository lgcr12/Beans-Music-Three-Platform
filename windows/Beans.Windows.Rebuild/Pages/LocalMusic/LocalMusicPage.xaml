<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.LocalMusic.LocalMusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localmodels="using:Beans.Windows.Rebuild.Services.LocalMusic">
    <UserControl.Resources>
        <DataTemplate x:Key="LocalTrackRowTemplate" x:DataType="localmodels:LocalTrack">
            <Grid Height="60" ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind DisplayPath}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="74" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="5" Background="{StaticResource SurfaceSecondaryBrush}"><Image Source="{x:Bind ArtworkUri}" Stretch="UniformToFill" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind FileName}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="本地音乐" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{x:Bind LyricStatusText}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{x:Bind AvailabilityText}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Artist}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind Album}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{x:Bind Format}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="6" Tag="{x:Bind}" Style="{StaticResource IconButtonStyle}" Click="QueueTrack_Click" AutomationProperties.Name="加入队列"><FontIcon Glyph="&#xE710;" FontSize="15" /></Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,32" Spacing="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="本地音乐" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="管理已扫描的音乐文件，音乐文件只保存在本机" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="AddFolder_Click" AutomationProperties.Name="添加本地音乐文件夹">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="14" /><TextBlock Text="添加文件夹" /></StackPanel>
                        </Button>
                        <Button x:Name="RescanButton" Style="{StaticResource GhostButtonStyle}" Click="Rescan_Click" AutomationProperties.Name="重新扫描本地音乐">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE895;" FontSize="14" /><TextBlock Text="重新扫描" /></StackPanel>
                        </Button>
                        <Button x:Name="CancelScanButton" Visibility="Collapsed" Style="{StaticResource GhostButtonStyle}" Click="CancelScan_Click" AutomationProperties.Name="取消本地音乐扫描">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE711;" FontSize="14" /><TextBlock Text="取消扫描" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border MinHeight="96" Style="{StaticResource SurfacePanelStyle}" Padding="18,14">
                    <Grid ColumnSpacing="18" RowSpacing="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3"><TextBlock Text="已扫描歌曲" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="TrackCountText" Text="0 首" Style="{StaticResource PanelTitleTextStyle}" /><TextBlock Text="当前可播放索引" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="音乐目录" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="FolderCountText" Text="0 个" Style="{StaticResource PanelTitleTextStyle}" /><TextBlock Text="只扫描用户选择的目录" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="最近播放" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="RecentlyPlayedText" Text="0 首" Style="{StaticResource PanelTitleTextStyle}" /><TextBlock Text="本机播放历史" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="最近扫描" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="LastScanText" Text="尚未扫描" Style="{StaticResource PanelTitleTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="StatusText" Text="音乐文件只保存在本机" Style="{StaticResource CaptionTextStyle}" MaxLines="2" TextWrapping="Wrap" /></StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ProgressPanel" Visibility="Collapsed" Style="{StaticResource SurfacePanelStyle}" Padding="18,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="正在建立本地音乐索引" Style="{StaticResource PanelTitleTextStyle}" />
                        <ProgressBar x:Name="ScanProgress" Minimum="0" Maximum="1" Value="0" Height="6" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Width="300" Spacing="12">
                        <TextBlock Text="音乐目录" Style="{StaticResource SectionTitleTextStyle}" />
                        <StackPanel x:Name="FolderListPanel" Spacing="8" />
                        <Border x:Name="FolderEmptyPanel" Padding="18" Style="{StaticResource SurfacePanelStyle}">
                            <StackPanel HorizontalAlignment="Center" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource Primary500Brush}" HorizontalAlignment="Center" /><TextBlock Text="还没有添加音乐目录" Style="{StaticResource PanelTitleTextStyle}" HorizontalAlignment="Center" /><TextBlock Text="添加一个音乐文件夹后开始扫描。" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock x:Name="ContentSectionTitle" Text="本地歌曲" Style="{StaticResource SectionTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="TracksCategoryButton" Content="歌曲" Tag="Tracks" Style="{StaticResource SecondaryButtonStyle}" Click="Category_Click" />
                            <Button x:Name="AlbumsCategoryButton" Content="专辑" Tag="Albums" Style="{StaticResource GhostButtonStyle}" Click="Category_Click" />
                            <Button x:Name="ArtistsCategoryButton" Content="艺术家" Tag="Artists" Style="{StaticResource GhostButtonStyle}" Click="Category_Click" />
                        </StackPanel>
                        <ListView x:Name="TrackList" ItemTemplate="{StaticResource LocalTrackRowTemplate}" ItemContainerStyle="{StaticResource MusicListViewItemStyle}" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="None" />
                        <StackPanel x:Name="GroupBrowser" Visibility="Collapsed" Spacing="14">
                            <GridView x:Name="GroupList" IsItemClickEnabled="True" ItemClick="Group_ItemClick" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="230" /></ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="localmodels:LocalMusicGroup">
                                        <Border Width="214" MinHeight="250" Margin="0,0,8,10" Padding="10" Style="{StaticResource SurfacePanelStyle}">
                                            <StackPanel Spacing="7">
                                                <Border Height="142" CornerRadius="6" Background="{StaticResource SurfaceSecondaryBrush}"><Image Source="{Binding ArtworkUri}" Stretch="UniformToFill" /></Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SecondaryText}" Style="{StaticResource SecondaryTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TrackCountText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionTextStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <Border x:Name="SelectedGroupPanel" Visibility="Collapsed" Padding="16,12" Style="{StaticResource SurfacePanelStyle}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Name="SelectedGroupTitle" Style="{StaticResource PanelTitleTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SelectedGroupDetails" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="收起" Style="{StaticResource GhostButtonStyle}" Click="CloseGroup_Click" />
                                    </Grid>
                                    <ListView x:Name="GroupTrackList" ItemTemplate="{StaticResource LocalTrackRowTemplate}" ItemContainerStyle="{StaticResource MusicListViewItemStyle}" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="None" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="8" Margin="20">
                            <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{StaticResource Primary500Brush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="还没有本地音乐" Style="{StaticResource PanelTitleTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyDescription" Text="添加一个音乐文件夹后，歌曲会显示在这里。" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
