<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.CreatedPlaylists.CreatedPlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Beans.Windows.Rebuild.Pages.CreatedPlaylists">
    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" Spacing="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{x:Bind PageTitle}" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="{x:Bind PageSubtitle}"
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="全部" Click="All_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="QQ 音乐" Click="Qq_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="网易云音乐" Click="NetEase_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="刷新" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SurfacePanelStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind SourceStatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />

                <StackPanel Spacing="12" Visibility="{x:Bind EmptyVisibility, Mode=OneWay}">
                    <TextBlock Text="平台歌单" Style="{StaticResource SectionTitleTextStyle}" />
                    <Border Style="{StaticResource SurfacePanelStyle}" Padding="28" MinHeight="180">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontSize="30" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="还没有可显示的平台歌单" Style="{StaticResource PanelTitleTextStyle}" />
                            <TextBlock Text="请先在账号与平台页完成官方登录并运行探针。"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="460" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                    <TextBlock Text="平台歌单" Style="{StaticResource SectionTitleTextStyle}" />
                    <GridView ItemsSource="{x:Bind Playlists}" IsItemClickEnabled="True"
                              SelectionMode="None" ItemClick="Playlist_ItemClick"
                              HorizontalContentAlignment="Stretch">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlatformPlaylistCard">
                                <Border Style="{StaticResource SurfacePanelStyle}" Width="260" Margin="0,0,12,12">
                                    <Grid RowDefinitions="150,Auto">
                                        <Image Source="{x:Bind CoverUri}" Stretch="UniformToFill" />
                                        <StackPanel Grid.Row="1" Padding="14" Spacing="5">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ProviderLine}" Style="{StaticResource CaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TrackCountText}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Beans 歌单" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button Grid.Column="1" Content="新建歌单" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="CreateBeansPlaylist_Click" />
                    </Grid>
                    <Border Style="{StaticResource SurfacePanelStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="歌单只保存在本机，不会自动写回 QQ 音乐或网易云音乐。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind BeansPlaylists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8" ColumnDefinitions="*,Auto" Tapped="BeansPlaylist_Tapped">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding TrackCountText}" Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="还没有 Beans 歌单，点击右上角新建一个。" Visibility="{x:Bind BeansEmptyVisibility, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
