<UserControl
    x:Class="Beans.Windows.Rebuild.Pages.Library.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="using:Beans.Windows.Rebuild.Services.Library">
    <Grid Background="Transparent" SizeChanged="Library_SizeChanged">


        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,32" Spacing="24">
                <Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="我的音乐" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="收藏、历史和自建歌单" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="新建歌单" Style="{StaticResource SecondaryButtonStyle}" Click="CreatePlaylist_Click" />
                        <Button Content="导入本地音乐" Style="{StaticResource PrimaryButtonStyle}" Click="ImportLocal_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="LibraryShortcuts" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="18" RowSpacing="12">
                    <Button x:Name="FavoritesShortcut" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" Padding="20" Height="112" Click="Favorites_Click">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="14"><Border Background="#2B47E8C4" CornerRadius="14" Height="48"><FontIcon Glyph="&#xEB51;" Foreground="#68F2CE" FontSize="28"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="我喜欢的音乐" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="收藏你喜欢的每一首歌" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Grid>
                    </Button>
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" Padding="20" Height="112" Click="History_Click">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="14"><Border Background="#2B4FA6EA" CornerRadius="14" Height="48"><FontIcon Glyph="&#xE81C;" Foreground="#75CFFF" FontSize="28"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="最近播放" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="回到你最近听过的歌曲" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Grid>
                    </Button>
                    <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}" Padding="20" Height="112" Click="Queue_Click">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="14"><Border Background="#2B8278E8" CornerRadius="14" Height="48"><FontIcon Glyph="&#xEA37;" Foreground="#ADA5FF" FontSize="28"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="播放队列" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="当前播放和即将播放的歌曲" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Grid>
                    </Button>
                </Grid>
                <Border Style="{StaticResource SurfacePanelStyle}" Padding="20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="收藏歌曲" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="FavoriteTrackCountText" Text="0 首" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="本机收藏" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="其他收藏" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="FavoriteContentCountText" Text="0 项" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="歌单、专辑和歌手" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="最近播放" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="HistoryCountText" Text="0 首" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="同一歌曲自动去重" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="自建歌单" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:Name="BeansPlaylistCountText" Text="0 个" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Beans 歌单" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Text="Beans 歌单" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Grid.Column="1" x:Name="BeansStatusText" Text="正在读取本机歌单…" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="刷新" Style="{StaticResource GhostButtonStyle}" Click="RefreshPlaylists_Click" />
                    </Grid>
                    <Grid ColumnDefinitions="*,190" ColumnSpacing="18">
                        <GridView ItemsSource="{x:Bind BeansPlaylists}" SelectionMode="None" MaxHeight="540" HorizontalAlignment="Stretch">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="176" ItemHeight="232"/></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemTemplate><DataTemplate><Border Style="{StaticResource SurfacePanelStyle}" Width="164" Padding="8" Tapped="BeansPlaylist_Tapped"><StackPanel Spacing="10"><Border Height="142" CornerRadius="10" Background="#29465A"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="48" Foreground="{StaticResource Primary400Brush}"/><Image Source="{Binding CoverUri}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" MaxLines="1"/><TextBlock Text="{Binding TrackCountText}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border></DataTemplate></GridView.ItemTemplate>
                        </GridView>
                        <Border Grid.Column="1" Style="{StaticResource SurfacePanelStyle}" Padding="16" VerticalAlignment="Top" MinHeight="224"><StackPanel VerticalAlignment="Center" Spacing="14"><FontIcon Glyph="&#xE8D6;" FontSize="44" Foreground="{StaticResource Primary400Brush}"/><TextBlock Text="创建你的专属歌单" TextAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="记录每一段心动的旋律" TextAlignment="Center" Style="{StaticResource CaptionTextStyle}"/><Button Content="创建歌单" Click="CreatePlaylist_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/></StackPanel></Border>
                    </Grid>
                    <TextBlock Text="还没有 Beans 歌单，点击创建歌单开始收藏。" Visibility="{x:Bind BeansEmptyVisibility, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Name="HistoryHeading" Text="最近播放" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button x:Name="ClearHistoryButton" Content="清空记录" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="ClearHistory_Click" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="正在读取音乐库…" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <Border x:Name="HistoryEmptyPanel" Style="{StaticResource SurfacePanelStyle}" Padding="28">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="还没有播放记录" Style="{StaticResource PanelTitleTextStyle}" />
                            <TextBlock Text="真实歌曲成功开始播放后会显示在这里。" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="HistoryPanel" Style="{StaticResource SurfacePanelStyle}" Padding="8" Visibility="Collapsed">
                        <ListView x:Name="HistoryList" IsItemClickEnabled="True" ItemClick="Track_ItemClick" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="library:PlaybackHistoryEntry">
                                    <Grid MinHeight="64" Padding="8,5" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="82" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="5" Background="{StaticResource SurfaceSecondaryBrush}"><Image Source="{x:Bind CoverUri}" Stretch="UniformToFill" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" /><TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" /></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Album}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{x:Bind PlatformName}" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Text="{x:Bind LastPlayedAtText}" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
                <TextBlock Text="在线歌曲只保存平台与歌曲标识；再次播放时仍由统一播放源解析器获取最新地址。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
