<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SurfacePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#263D6973" />
        <Setter Property="BorderBrush" Value="#365F8990" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style x:Key="StatusPanelStyle" TargetType="Border" BasedOn="{StaticResource SurfacePanelStyle}">
        <Setter Property="Background" Value="#70133345" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
</ResourceDictionary>
