<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Color x:Key="AnimeSky">#EDF6FF</Color>
    <Color x:Key="AnimeInk">#27466D</Color>
    <Color x:Key="AnimeNight">#13243A</Color>
    <Color x:Key="AnimeMint">#63E7C2</Color>
    <SolidColorBrush x:Key="AnimeSkyBrush" Color="{StaticResource AnimeSky}"/>
    <SolidColorBrush x:Key="AnimeInkBrush" Color="{StaticResource AnimeInk}"/>
    <SolidColorBrush x:Key="AnimeNightBrush" Color="{StaticResource AnimeNight}"/>
    <SolidColorBrush x:Key="AnimeMintBrush" Color="{StaticResource AnimeMint}"/>
    <Style x:Key="AnimeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#365C88"/>
        <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="24"/><Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,7"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.72"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.38"/></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                <Border x:Name="Hover" Background="#184E9DFF" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}"/>
                <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AnimePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AnimeButtonStyle}">
        <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="22,10"/>
        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#619EF9" Offset="0"/><GradientStop Color="#3181ED" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="AnimeDarkButtonStyle" TargetType="Button" BasedOn="{StaticResource AnimeButtonStyle}">
        <Setter Property="Foreground" Value="#F4F8FF"/><Setter Property="Background" Value="#245D7898"/>
        <Setter Property="BorderBrush" Value="#357B9FC3"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="AnimeVioletButtonStyle" TargetType="Button" BasedOn="{StaticResource AnimePrimaryButtonStyle}">
        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8581FF" Offset="0"/><GradientStop Color="#625BF4" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
    </Style>
    <Style x:Key="AnimeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AnimeButtonStyle}">
        <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="7"/>
    </Style>
    <Style x:Key="AnimeStickerButtonStyle" TargetType="Button" BasedOn="{StaticResource AnimeIconButtonStyle}">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="#40FFFFFF"/><Setter Property="BorderBrush" Value="#75FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style x:Key="AnimeThumbStyle" TargetType="p:Thumb"><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:Thumb"><Ellipse Fill="{TemplateBinding Foreground}" Stroke="#DFFFFFFF" StrokeThickness="1.5"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AnimeSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="#529AF4"/><Setter Property="Background" Value="#30699FD7"/>
        <Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid x:Name="Root" Background="Transparent">
                <Border Height="3" Margin="5,0" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="2" IsHitTestVisible="False"/>
                <Grid x:Name="HorizontalTemplate" Background="Transparent" Margin="5,0" ColumnDefinitions="Auto,Auto,*">
                <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Center" Fill="#5595B7DE" RadiusX="2" RadiusY="2"/>
                <Rectangle x:Name="HorizontalDecreaseRect" Height="3" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2"/>
                <p:Thumb x:Name="HorizontalThumb" Grid.Column="1" Foreground="{TemplateBinding Foreground}" Style="{StaticResource AnimeThumbStyle}"/>
            </Grid></Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AnimeChoiceStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="52"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid x:Name="Root" Background="Transparent" CornerRadius="10">
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked"/><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Root.Background" Value="#E8EFFD"/><Setter Target="Circle.Fill" Value="#398AF3"/><Setter Target="Circle.Stroke" Value="#398AF3"/><Setter Target="Check.Opacity" Value="1"/></VisualState.Setters></VisualState>
                </VisualStateGroup><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.85"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Grid Padding="{TemplateBinding Padding}" ColumnDefinitions="*,22" ColumnSpacing="12"><ContentPresenter Content="{TemplateBinding Content}" Foreground="#344A68" VerticalAlignment="Center"/><Grid Grid.Column="1" Width="19" Height="19"><Ellipse x:Name="Circle" Fill="Transparent" Stroke="#B8C6D7" StrokeThickness="1"/><FontIcon x:Name="Check" Glyph="&#xE73E;" FontSize="11" Foreground="White" Opacity="0"/></Grid></Grid>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
