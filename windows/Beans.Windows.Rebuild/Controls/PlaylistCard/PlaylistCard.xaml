<UserControl
    x:Class="Beans.Windows.Rebuild.Controls.PlaylistCard.PlaylistCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:badge="using:Beans.Windows.Rebuild.Controls.PlatformBadge"
    PointerEntered="Card_PointerEntered"
    PointerExited="Card_PointerExited">
    <Button x:Name="CardButton"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="CardButton_Click"
            AutomationProperties.Name="播放歌单">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter />
            </ControlTemplate>
        </Button.Template>
        <StackPanel Spacing="8">
            <Border x:Name="CoverBorder" CornerRadius="8" Background="{StaticResource SurfaceSecondaryBrush}" SizeChanged="CoverBorder_SizeChanged">
                <Grid>
                    <Image x:Name="CoverImage"
                           Stretch="UniformToFill" />
                    <Border x:Name="PlayOverlay"
                            Width="42" Height="42"
                            Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#EFFFFFFF"
                            CornerRadius="21"
                            Opacity="0">
                        <FontIcon Glyph="&#xE768;" FontSize="17" Foreground="{StaticResource Primary700Brush}" />
                    </Border>
                    <badge:PlatformBadge x:Name="SourceBadge" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Border Margin="8" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#99033C35" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="White" />
                            <TextBlock x:Name="PlayCountText" FontSize="11" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource CardTitleTextStyle}" MaxLines="1" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextStyle}" MaxLines="1" />
        </StackPanel>
    </Button>
</UserControl>
