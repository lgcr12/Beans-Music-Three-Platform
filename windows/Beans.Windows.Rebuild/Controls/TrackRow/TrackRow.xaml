<UserControl
    x:Class="Beans.Windows.Rebuild.Controls.TrackRow.TrackRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:badge="using:Beans.Windows.Rebuild.Controls.PlatformBadge">
    <Grid Height="58" Padding="10,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="1.6*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="24" HorizontalAlignment="Left">
            <TextBlock x:Name="IndexText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel x:Name="CurrentBars" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Rectangle Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Primary600Brush}" />
                <Rectangle Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Primary600Brush}" />
                <Rectangle Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Primary600Brush}" />
            </StackPanel>
        </Grid>
        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="5" Background="{StaticResource SurfaceSecondaryBrush}">
            <Image x:Name="CoverImage" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" MaxLines="1" />
            <badge:PlatformBadge x:Name="SourceBadge" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock x:Name="ArtistText" Grid.Column="3" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" MaxLines="1" />
        <TextBlock x:Name="AlbumText" Grid.Column="4" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" MaxLines="1" />
        <TextBlock x:Name="DurationText" Grid.Column="5" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</UserControl>
