<UserControl
    x:Class="Beans.Windows.Rebuild.Controls.BottomPlayer.BottomPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PlayerRoot" Height="96" Background="#F7FFFFFF" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftColumn.Width" Value="220" />
                        <Setter Target="RightColumn.Width" Value="180" />
                        <Setter Target="AlbumText.Visibility" Value="Collapsed" />
                        <Setter Target="AlbumSeparator.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftColumn.Width" Value="260" />
                        <Setter Target="RightColumn.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1360" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftColumn.Width" Value="300" />
                        <Setter Target="RightColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="180" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="22,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
            <Border Width="58" Height="58" CornerRadius="6" Background="{StaticResource SurfaceSecondaryBrush}" Tapped="OpenPlayer_Tapped" ToolTipService.ToolTip="打开播放器" AutomationProperties.Name="打开播放器">
                <Image Source="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Tapped="OpenPlayer_Tapped" ToolTipService.ToolTip="打开播放器" AutomationProperties.Name="打开播放器">
                <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" FontWeight="SemiBold" MaxLines="1" />
                <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" MaxLines="1" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="AlbumText" Text="{x:Bind Player.Album, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" />
                    <TextBlock x:Name="AlbumSeparator" Text="·" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{x:Bind Player.SourceLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" />
                </StackPanel>
                <TextBlock Text="{x:Bind Player.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="Favorite_Click" AutomationProperties.Name="收藏当前歌曲">
                <FontIcon Glyph="&#xEB51;" FontSize="17" />
            </Button>
        </Grid>

        <Grid Grid.Column="1" Margin="20,8" MaxWidth="700">
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="28" /></Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="9">
                <Button x:Name="PlaybackModeButton" Style="{StaticResource IconButtonStyle}" Click="PlaybackMode_Click" AutomationProperties.Name="播放模式" ToolTipService.ToolTip="播放模式"><FontIcon x:Name="PlaybackModeIcon" Glyph="&#xE8EE;" FontSize="17" /></Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Previous_Click" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="18" /></Button>
                <Button Style="{StaticResource MainPlayButtonStyle}" Click="PlayPause_Click" AutomationProperties.Name="播放或暂停"><FontIcon Glyph="{x:Bind Player.PlayPauseGlyph, Mode=OneWay}" FontSize="21" /></Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Next_Click" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="18" /></Button>
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource MusicSliderStyle}" Minimum="0" Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" KeyUp="ProgressSlider_KeyUp" AutomationProperties.Name="播放进度" />
                <TextBlock Grid.Column="2" Text="{x:Bind Player.DurationText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <StackPanel Grid.Column="2" Margin="8,0,20,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
            <Button x:Name="QualityButton" MinWidth="38" Height="34" Padding="6,0" Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="选择音质" ToolTipService.ToolTip="选择播放音质">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Border Background="{StaticResource SurfacePrimaryBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel Width="210" Spacing="4">
                                <TextBlock Text="播放音质" Style="{StaticResource PanelTitleTextStyle}" Margin="4,0,4,5" />
                                <Button Content="标准" Tag="Standard" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" />
                                <Button Content="HQ · 高品质" Tag="High" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" />
                                <Button Content="SQ · 超高品质" Tag="VeryHigh" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" />
                                <Button Content="无损" Tag="Lossless" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" />
                                <Button Content="Hi-Res" Tag="HiRes" Click="QualityOption_Click" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <TextBlock Text="{x:Bind Player.QualityLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
            </Button>
            <FontIcon Glyph="&#xE767;" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" />
            <Slider x:Name="VolumeSlider" Width="88" Style="{StaticResource VolumeSliderStyle}" Minimum="0" Maximum="100" Value="{x:Bind Player.VolumePercent, Mode=OneWay}" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="音量" />
            <Button Style="{StaticResource IconButtonStyle}" Click="Lyrics_Click" AutomationProperties.Name="打开歌词"><FontIcon Glyph="&#xE8D2;" FontSize="17" /></Button>
            <Button Style="{StaticResource IconButtonStyle}" Click="Queue_Click" AutomationProperties.Name="打开播放队列"><FontIcon Glyph="&#xEA37;" FontSize="17" /></Button>
        </StackPanel>
    </Grid>
</UserControl>
