<UserControl
    x:Class="Beans.Windows.Rebuild.Controls.PlatformBadge.PlatformBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="BadgeRoot" Height="20" Padding="5,0" Background="{StaticResource Primary050Brush}" BorderBrush="{StaticResource Primary200Brush}" BorderThickness="1" CornerRadius="4">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Border x:Name="LogoBackground" Width="12" Height="12" CornerRadius="6" Background="{StaticResource Primary600Brush}">
                <TextBlock x:Name="LogoText" FontSize="7" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
            <TextBlock x:Name="LabelText" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
