<UserControl
    x:Class="Beans.Windows.Rebuild.Shell.TopBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#ECF8FBFA">
        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="44" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" />
        <Grid x:Name="ActionsGrid" Grid.Row="1" Margin="24,0,154,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="520" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /><ColumnDefinition x:Name="NotificationColumn" Width="40" /><ColumnDefinition x:Name="ProfileColumn" Width="40" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="42" Background="#DFFFFFFF" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="21">
                <Grid Padding="16,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="SearchTextBox" Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}" PlaceholderText="搜索歌曲、歌手、专辑或歌单" KeyDown="SearchTextBox_KeyDown" TextChanged="SearchTextBox_TextChanged" AutomationProperties.Name="全局搜索" />
                </Grid>
            </Border>
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="Theme_Click" AutomationProperties.Name="主题设置"><FontIcon Glyph="&#xE790;" FontSize="18" /></Button>
            <Button x:Name="NotificationButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="Notification_Click" AutomationProperties.Name="通知"><FontIcon Glyph="&#xEA8F;" FontSize="18" /></Button>
            <Button x:Name="ProfileButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="Profile_Click" AutomationProperties.Name="账号与平台">
                <Border Width="34" Height="34" Background="{StaticResource Primary200Brush}" CornerRadius="17"><FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{StaticResource Primary700Brush}" /></Border>
            </Button>
        </Grid>
        <Popup x:Name="SuggestionPopup" IsLightDismissEnabled="True" HorizontalOffset="24" VerticalOffset="72">
            <Border Width="520" MaxHeight="280" Background="{StaticResource SurfacePrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="6">
                <ListView x:Name="SuggestionList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="SuggestionList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8,5" Spacing="2"><TextBlock Text="{Binding Text}" MaxLines="1" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextStyle}" MaxLines="1" /></StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</UserControl>
