<Window
    x:Class="Beans.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Title="Beans Music">
    <Grid x:Name="Root" Background="{ThemeResource BeansBackgroundBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="220" CompactPaneLength="58"
                        IsSettingsVisible="True" SelectionChanged="Navigation_SelectionChanged"
                        Background="Transparent" Foreground="{ThemeResource BeansTextBrush}" IsBackButtonVisible="Collapsed">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,8,0,12">
                    <Image Source="Assets/Square44x44Logo.png" Width="30" Height="30"/>
                    <TextBlock Text="Beans Music" FontSize="{Binding SubtitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="home" Icon="Home" />
                <NavigationViewItem Content="搜索" Tag="search" Icon="Find" />
                <NavigationViewItem Content="音乐库" Tag="library" Icon="Library" />
                <NavigationViewItem Content="下载" Tag="downloads" Icon="Download" />
                <NavigationViewItem Content="本地音乐" Tag="local" Icon="Audio" />
                <NavigationViewItem Content="播放列表" Tag="queue" Icon="Bullets" />
                <NavigationViewItem Content="账号中心" Tag="account" Icon="Contact" />
            </NavigationView.MenuItems>
            <Grid Padding="24,16,20,16" ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightRailColumn" Width="320"/></Grid.ColumnDefinitions>
                <ScrollViewer>
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PageEyebrow" Text="BEANS MUSIC" Foreground="{ThemeResource BeansPrimaryBrush}" FontWeight="SemiBold" />
                                <TextBlock x:Name="PageTitle" Text="晚上好" FontSize="{Binding TitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PageSubtitle" Text="从三个平台继续你的音乐旅程" Foreground="{ThemeResource BeansMutedBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemePicker" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="150" SelectionChanged="ThemePicker_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="青碧玻璃" Tag="aurora"/><ComboBoxItem Content="清透纸感" Tag="paper"/><ComboBoxItem Content="午夜霓虹" Tag="midnight"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="16">
                            <Border Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="22">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <TextBlock Text="全局字号" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}"/>
                                        <TextBlock Text="{Binding DisplayPercent, Source={StaticResource BeansTypography}, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource BeansPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="FontScaleSlider" Minimum="85" Maximum="140" StepFrequency="5"
                                            Value="{Binding Percent, Source={StaticResource BeansTypography}, Mode=TwoWay}"
                                            ValueChanged="FontScaleSlider_ValueChanged" AutomationProperties.Name="全局字号"/>
                                    <Border Background="#16000000" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="音乐让今天更有层次" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource BeansTextBrush}"/>
                                            <TextBlock Text="标题、正文与辅助文字会即时预览" TextWrapping="Wrap" Foreground="{ThemeResource BeansTextBrush}"/>
                                            <TextBlock Text="歌词保留播放器中的独立字号设置" FontSize="{Binding CaptionSize, Source={StaticResource BeansTypography}, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="范围 85% - 140%，同时尊重 Windows 系统文本缩放" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                        <Button Grid.Column="1" Content="恢复默认" HorizontalAlignment="Right" Click="ResetFontScale_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="22">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="播放器视觉" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}"/>
                                    <ComboBox x:Name="PlayerEffectPicker" Header="视觉模式" SelectionChanged="PlayerEffectPicker_SelectionChanged">
                                        <ComboBoxItem Content="静谧" Tag="quiet"/><ComboBoxItem Content="流光" Tag="flow"/><ComboBoxItem Content="星尘波纹" Tag="stardust"/><ComboBoxItem Content="频谱舞台" Tag="spectrum"/><ComboBoxItem Content="经典黑胶" Tag="vinyl"/>
                                    </ComboBox>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="PlayerEffectIntensitySlider" Minimum="0.25" Maximum="1" StepFrequency="0.05" ValueChanged="PlayerEffectIntensity_ValueChanged" AutomationProperties.Name="播放器特效强度"/>
                                        <TextBlock Grid.Column="1" x:Name="PlayerEffectIntensityText" VerticalAlignment="Center" Foreground="{ThemeResource BeansMutedBrush}"/>
                                    </Grid>
                                    <TextBlock Text="本地音乐由 AudioGraph 读取真实分析帧；平台流媒体使用非侵入式节奏动画。系统关闭动画时自动显示静态版本。" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="22">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="歌词显示" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}"/>
                                    <ComboBox x:Name="LyricStylePicker" Header="样式预设" SelectionChanged="LyricStylePicker_SelectionChanged">
                                        <ComboBoxItem Content="极简" Tag="minimal"/><ComboBoxItem Content="流光" Tag="flow"/><ComboBoxItem Content="逐行卡拉 OK" Tag="karaoke"/><ComboBoxItem Content="高对比" Tag="contrast"/><ComboBoxItem Content="自定义" Tag="custom" Visibility="Collapsed"/>
                                    </ComboBox>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="LyricFontSizeSlider" Minimum="12" Maximum="40" StepFrequency="1" ValueChanged="LyricSetting_ValueChanged" AutomationProperties.Name="歌词字号"/>
                                        <TextBlock Grid.Column="1" x:Name="LyricFontSizeText" VerticalAlignment="Center" Foreground="{ThemeResource BeansMutedBrush}"/>
                                    </Grid>
                                    <Slider x:Name="LyricLineSpacingSlider" Header="行距" Minimum="0" Maximum="20" StepFrequency="1" ValueChanged="LyricSetting_ValueChanged"/>
                                    <ToggleSwitch x:Name="LyricTranslationToggle" Header="显示翻译" Toggled="LyricSetting_Toggled"/>
                                    <ComboBox x:Name="LyricAlignmentPicker" Header="对齐方式" SelectionChanged="LyricSetting_SelectionChanged">
                                        <ComboBoxItem Content="左对齐" Tag="leading"/><ComboBoxItem Content="居中" Tag="center"/>
                                    </ComboBox>
                                    <Expander Header="高级设置">
                                        <StackPanel Spacing="10" Padding="0,10,0,0">
                                            <TextBlock Text="高亮颜色" Foreground="{ThemeResource BeansTextBrush}"/>
                                            <ColorPicker x:Name="LyricColorPicker" IsAlphaEnabled="False" ColorChanged="LyricAdvancedColor_Changed" AutomationProperties.Name="歌词高亮颜色"/>
                                            <ToggleSwitch x:Name="LyricGlowToggle" Header="发光" Toggled="LyricAdvanced_Toggled"/>
                                            <ToggleSwitch x:Name="LyricBlurToggle" Header="非当前行轻微模糊" Toggled="LyricAdvanced_Toggled"/>
                                            <ToggleSwitch x:Name="LyricItalicToggle" Header="倾斜" Toggled="LyricAdvanced_Toggled"/>
                                            <ComboBox x:Name="LyricBackgroundPicker" Header="歌词背景" SelectionChanged="LyricAdvanced_SelectionChanged">
                                                <ComboBoxItem Content="透明" Tag="clear"/><ComboBoxItem Content="柔和遮罩" Tag="soft"/><ComboBoxItem Content="高对比遮罩" Tag="contrast"/>
                                            </ComboBox>
                                            <NumberBox x:Name="LyricOffsetBox" Header="时间偏移（秒）" Minimum="-5" Maximum="5" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="LyricAdvancedOffset_Changed"/>
                                            <TextBlock Text="自定义背景图片仅保存在本机。高对比预设会关闭模糊和发光。" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="22">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="应用与更新" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}"/>
                                    <ToggleSwitch x:Name="AutomaticUpdateToggle" Header="应用内更新通知" Toggled="AutomaticUpdateToggle_Toggled"/>
                                    <TextBlock Text="开启后每 24 小时检查一次 GitHub Releases；不会静默安装。" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                    <Button Content="检查更新" Click="CheckUpdate_Click" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="UpdateStatus" Text="尚未检查" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="22">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="应用信息" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}"/>
                                    <TextBlock Text="Beans Music · Windows 11" Foreground="{ThemeResource BeansMutedBrush}"/>
                                    <TextBlock Text="平台凭证只在客户端解密使用；Beans 不代理受版权保护的音频。" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="MusicUniversePanel" Visibility="Collapsed" Spacing="16">
                            <Border x:Name="UniverseHero" CornerRadius="8" Padding="24" MinHeight="260" BorderThickness="1" BorderBrush="#3855E1B2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E8072A25" Offset="0"/>
                                        <GradientStop Color="#EE07121B" Offset="0.64"/>
                                        <GradientStop Color="#C5322454" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid ColumnSpacing="26">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="190" Height="190" CornerRadius="8" Background="#2024CEF5">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="54" Foreground="{ThemeResource BeansPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="UniversePlayingState" Text="等待第一首歌" FontWeight="SemiBold" Foreground="{ThemeResource BeansPrimaryBrush}"/>
                                        <TextBlock x:Name="UniverseCurrentTitle" Text="从本地音乐开始建立你的音乐宇宙" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="UniverseCurrentArtist" Text="播放后，这里会展示最近心动与听歌统计" Foreground="#CFFFFFFF" TextWrapping="Wrap"/>
                                        <StackPanel Spacing="10">
                                            <Button Content="播放 / 暂停" Click="ToggleUniversePlayback_Click" Style="{StaticResource AccentButtonStyle}"/>
                                            <Button x:Name="FavoriteCurrentButton" Content="收藏当前" Click="FavoriteCurrent_Click"/>
                                            <Button Content="管理账号" Click="OpenAccountFromProfile_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="5"><FontIcon Glyph="&#xE768;" Foreground="{ThemeResource BeansPrimaryBrush}"/><TextBlock x:Name="UniversePlayCount" Text="0" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold"/><TextBlock Text="累计播放" Foreground="{ThemeResource BeansMutedBrush}"/></StackPanel></Border>
                                <Border Grid.Column="1" Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="5"><FontIcon Glyph="&#xEB52;" Foreground="{ThemeResource BeansPrimaryBrush}"/><TextBlock x:Name="UniverseFavoriteCount" Text="0" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold"/><TextBlock Text="收藏歌曲" Foreground="{ThemeResource BeansMutedBrush}"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="5"><FontIcon Glyph="&#xE735;" Foreground="{ThemeResource BeansPrimaryBrush}"/><TextBlock x:Name="UniverseTopTrack" Text="暂无" FontSize="{Binding SubtitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="最常播放" Foreground="{ThemeResource BeansMutedBrush}"/></StackPanel></Border>
                            </Grid>
                            <Grid>
                                <TextBlock Text="最近心动" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}"/>
                                <Button Content="打开本地音乐" HorizontalAlignment="Right" Click="OpenLocalFromProfile_Click"/>
                            </Grid>
                            <ListView x:Name="UniverseRecentList" MinHeight="220" Background="Transparent" DoubleTapped="UniverseRecentList_DoubleTapped">
                                <ListViewItem IsEnabled="False"><TextBlock Text="还没有播放记录，去听一首歌吧" Foreground="{ThemeResource BeansMutedBrush}"/></ListViewItem>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="MainContentPanel" Spacing="18">
                        <Grid x:Name="SearchPanel" Visibility="Collapsed" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Header="搜索本地音乐" PlaceholderText="输入歌名或文件名" TextChanged="SearchBox_TextChanged"/>
                            <Button Grid.Column="1" Content="清除" VerticalAlignment="Bottom" Click="ClearSearch_Click"/>
                        </Grid>
                        <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Spacing="10">
                            <TextBlock Text="本机下载" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="仅下载你从平台官方客户端取得、且有权保存的音频地址。Beans 不代理受版权保护的音频。" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                            <TextBox x:Name="DownloadUrlBox" Header="合法音频地址" PlaceholderText="https://…"/>
                            <TextBox x:Name="DownloadNameBox" Header="文件名" PlaceholderText="歌曲名称.mp3"/>
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="开始断点下载" Click="StartDownload_Click"/>
                                <Button Grid.Column="1" Content="取消下载" Click="CancelDownload_Click"/>
                            </Grid>
                            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="1"/>
                            <TextBlock x:Name="DownloadStatus" Text="暂无下载任务" Foreground="{ThemeResource BeansMutedBrush}"/>
                        </StackPanel>

                        <Border x:Name="AuroraHome" CornerRadius="8" Padding="24" MinHeight="210">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D9146559" Offset="0"/>
                                    <GradientStop Color="#E9072925" Offset="0.62"/>
                                    <GradientStop Color="#B37A5428" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnSpacing="22">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="早上好" FontSize="{Binding TitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="让音乐陪你开始今天" FontSize="{Binding BodySize, Source={StaticResource BeansTypography}, Mode=OneWay}" Foreground="#CFFFFFFF" TextWrapping="Wrap"/>
                                    <Button Width="44" Height="44" CornerRadius="22" Padding="0" Background="{ThemeResource BeansPrimaryBrush}" Foreground="#062D27" AutomationProperties.Name="播放推荐音乐">
                                        <FontIcon Glyph="&#xE768;" FontSize="17"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="跨端音乐" FontSize="{Binding CaptionSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="QQ 音乐与网易云授权在本机安全恢复，歌单与最近播放自动同步。" TextWrapping="Wrap" Foreground="#BFFFFFFF"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="58" Height="58" CornerRadius="7" Background="#2AFFFFFF"/>
                                        <Border Width="58" Height="58" CornerRadius="7" Background="#20FFFFFF"/>
                                        <Border Width="58" Height="58" CornerRadius="7" Background="#18FFFFFF"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="PaperHome" Visibility="Collapsed" ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="12">
                                <TextBlock Text="推荐歌单" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="7"><Border Height="112" CornerRadius="5" Background="#DDEBE5"/><TextBlock Text="每日推荐" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="7"><Border Height="112" CornerRadius="5" Background="#D9E8DD"/><TextBlock Text="轻音乐" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="7"><Border Height="112" CornerRadius="5" Background="#DDE4EB"/><TextBlock Text="华语经典" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="7"><Border Height="112" CornerRadius="5" Background="#E8E5DD"/><TextBlock Text="数字浪潮" FontWeight="SemiBold"/></StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <TextBlock Text="本地音乐" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                                <Border BorderBrush="#16000000" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid Padding="12,10"><TextBlock Text="音乐"/><TextBlock Text="全部歌曲" HorizontalAlignment="Right" Foreground="{ThemeResource BeansMutedBrush}"/></Grid>
                                        <Rectangle Height="1" Fill="#12000000"/>
                                        <Grid Padding="12,10"><TextBlock Text="歌单"/><TextBlock Text="跨端同步" HorizontalAlignment="Right" Foreground="{ThemeResource BeansMutedBrush}"/></Grid>
                                        <Rectangle Height="1" Fill="#12000000"/>
                                        <Grid Padding="12,10"><TextBlock Text="下载"/><TextBlock Text="仅保存在本机" HorizontalAlignment="Right" Foreground="{ThemeResource BeansMutedBrush}"/></Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="MidnightHome" Visibility="Collapsed" CornerRadius="8" Padding="22" BorderBrush="#374DC7F2" BorderThickness="1" Background="#EA06111D">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="142" Height="142" CornerRadius="8" Background="#142A43">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="44" Foreground="#24CEF5"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Center">
                                    <TextBlock Text="午夜电台" FontSize="{Binding TitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" Foreground="#F2FAFF" TextWrapping="Wrap"/>
                                    <TextBlock Text="选择一首歌，进入沉浸播放舞台" Foreground="#8196A8"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5" Height="54" VerticalAlignment="Center">
                                        <Rectangle Width="6" Height="18" RadiusX="3" Fill="#18D4F6"/><Rectangle Width="6" Height="34" RadiusX="3" Fill="#1EB9F3"/>
                                        <Rectangle Width="6" Height="48" RadiusX="3" Fill="#398CF5"/><Rectangle Width="6" Height="27" RadiusX="3" Fill="#7465EF"/>
                                        <Rectangle Width="6" Height="42" RadiusX="3" Fill="#B64DDE"/><Rectangle Width="6" Height="52" RadiusX="3" Fill="#EE347D"/>
                                        <Rectangle Width="6" Height="31" RadiusX="3" Fill="#FF4B60"/><Rectangle Width="6" Height="22" RadiusX="3" Fill="#FC704A"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="22">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="跨端音乐保险库" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HeroStatus" Text="QQ 音乐与网易云可直接授权；登录 Beans 账号后可跨端恢复。" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="AccountButton" Content="登录 Beans 账号" Click="AccountButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="最近播放" FontSize="{Binding HeadingSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                        <ListView x:Name="ContentList" MinHeight="320" Background="Transparent" DoubleTapped="ContentList_DoubleTapped">
                            <ListViewItem><TextBlock Text="登录后将在这里显示跨端歌单与最近播放" Foreground="{ThemeResource BeansMutedBrush}"/></ListViewItem>
                        </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Background="{ThemeResource BeansSurfaceBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,8">
                    <StackPanel Spacing="14">
                        <TextBlock Text="接下来播放" FontSize="{Binding SubtitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="QueueStatus" Text="队列为空" Foreground="{ThemeResource BeansMutedBrush}"/>
                        <Rectangle Height="1" Fill="{ThemeResource BeansMutedBrush}" Opacity="0.25"/>
                        <TextBlock Text="歌词" FontSize="{Binding SubtitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LyricsStatus" Text="播放音乐后显示滚动歌词" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                        <ListView x:Name="LyricsList" MaxHeight="280" Background="Transparent" SelectionMode="Single" IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>
            </Grid>
        </NavigationView>
        <Border Grid.Row="1" Background="{ThemeResource BeansSurfaceBrush}" Padding="18,12" MinHeight="92">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <Canvas x:Name="PlayerEffectCanvas" Grid.ColumnSpan="3" Height="76" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.72"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="8" Background="{ThemeResource BeansPrimaryBrush}"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PlayerTitle" Text="尚未播放" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/><TextBlock x:Name="PlayerArtist" Text="Beans Music" Foreground="{ThemeResource BeansMutedBrush}" TextWrapping="Wrap"/></StackPanel>
                </StackPanel>
                <MediaPlayerElement x:Name="Player" Grid.Column="1" AreTransportControlsEnabled="True" AutoPlay="False" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <Button Content="歌词" Click="ShowLyrics_Click"/><Button Content="队列" Click="ShowQueue_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="AccountOverlay" Grid.RowSpan="2" Background="#AA000000" Visibility="Collapsed">
            <Grid><Border Width="520" MaxHeight="720" Padding="28" CornerRadius="28" Background="{ThemeResource BeansSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer><StackPanel Spacing="14">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Beans 本体账号" FontSize="{Binding TitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="关闭" HorizontalAlignment="Right" Click="CloseAccount_Click"/></Grid>
                    <TextBlock Text="一次登录，三端恢复授权并共享歌单" Foreground="{ThemeResource BeansMutedBrush}"/>
                    <TextBox x:Name="ServerBox" Header="账号服务地址" Text="http://localhost:8080/"/>
                    <TextBox x:Name="NicknameBox" Header="昵称（注册时填写）"/>
                    <TextBox x:Name="EmailBox" Header="邮箱"/>
                    <PasswordBox x:Name="PasswordBox" Header="密码（至少 8 位）"/>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="登录" Click="Login_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Grid.Column="1" Content="注册" Click="Register_Click"/>
                    </Grid>
                    <TextBox x:Name="VerificationBox" Header="6 位邮箱验证码"/>
                    <Button Content="验证邮箱并登录" Click="Verify_Click"/>
                    <Button Content="显示本机扫码登录二维码" Click="CreateQr_Click"/>
                    <Image x:Name="QrImage" Width="220" Height="220" Visibility="Collapsed"/>
                    <TextBlock x:Name="QrCodeText" FontSize="{Binding SubtitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource BeansSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AccountStatus" Text="未登录" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="立即同步" Click="SyncNow_Click"/>
                        <Button Grid.Column="1" Content="退出 Beans 账号" Click="Logout_Click" Foreground="OrangeRed"/>
                    </Grid>
                    <Expander Header="确认另一台设备的扫码登录">
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <TextBox x:Name="ApprovalPayloadBox" Header="二维码内容" PlaceholderText="beans://account/qr?session=…"/>
                            <TextBox x:Name="ApprovalCodeBox" Header="新设备上显示的 6 位校验码"/>
                            <Button Content="确认登录新设备" Click="ApproveQr_Click"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="平台授权（无需登录 Beans）" FontSize="{Binding SubtitleSize, Source={StaticResource BeansTypography}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource BeansTextBrush}" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="授权 QQ 音乐" Click="AuthorizeQq_Click"/>
                        <Button Grid.Column="1" Content="授权网易云音乐" Click="AuthorizeNetease_Click"/>
                    </Grid>
                    <Border Background="#16000000" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid><TextBlock Text="凭证有效性" FontWeight="SemiBold"/><Ellipse x:Name="CredentialAttentionDot" Width="8" Height="8" Fill="OrangeRed" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid>
                            <ToggleSwitch x:Name="AutomaticProbeToggle" Header="每 24 小时自动检测" Toggled="AutomaticProbeToggle_Toggled"/>
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="QQ 音乐"/><TextBlock x:Name="QqProbeStatus" Text="未检测" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/></StackPanel>
                                <Button Grid.Column="1" Content="立即检测" Click="ProbeQq_Click"/>
                            </Grid>
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="网易云音乐"/><TextBlock x:Name="NeteaseProbeStatus" Text="未检测" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/></StackPanel>
                                <Button Grid.Column="1" Content="立即检测" Click="ProbeNetease_Click"/>
                            </Grid>
                            <Button Content="检测全部" Click="ProbeAll_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Expander Header="设备管理">
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <Button Content="刷新设备" Click="RefreshDevices_Click"/>
                            <ListView x:Name="DevicesList" Height="150" SelectionMode="Single"/>
                            <Button Content="撤销选中设备" Click="RevokeDevice_Click" Foreground="OrangeRed"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="忘记密码">
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <TextBlock Text="重置会销毁旧的跨端保险库并注销全部 Beans 设备；当前设备的平台授权保持不变。" TextWrapping="Wrap" Foreground="{ThemeResource BeansMutedBrush}"/>
                            <TextBox x:Name="ResetEmailBox" Header="账号邮箱"/>
                            <Button Content="发送重置验证码" Click="StartReset_Click"/>
                            <TextBox x:Name="ResetCodeBox" Header="6 位验证码"/>
                            <PasswordBox x:Name="ResetPasswordBox" Header="新密码（至少 8 位）"/>
                            <Button Content="重置密码并清空旧跨端保险库" Click="CompleteReset_Click" Foreground="OrangeRed"/>
                        </StackPanel>
                    </Expander>
                </StackPanel></ScrollViewer>
            </Border></Grid>
        </Border>
        <Border x:Name="TopBanner" Grid.RowSpan="2" Margin="18,12" Padding="14,10" CornerRadius="8" Background="#F0202A31" BorderBrush="{ThemeResource BeansPrimaryBrush}" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed" Canvas.ZIndex="40">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" Foreground="{ThemeResource BeansPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"><TextBlock x:Name="TopBannerTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TopBannerMessage" Foreground="{ThemeResource BeansMutedBrush}" TextWrapping="Wrap"/></StackPanel>
                <Button x:Name="TopBannerPrimary" Grid.Column="2" Content="查看" Click="TopBannerPrimary_Click"/>
                <Button x:Name="TopBannerLater" Grid.Column="3" Content="稍后提醒" Click="TopBannerLater_Click"/>
                <Button x:Name="TopBannerIgnore" Grid.Column="4" Content="忽略此版本" Click="TopBannerIgnore_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
